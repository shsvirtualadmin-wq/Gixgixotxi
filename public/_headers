# Cloudflare Pages Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/platform/headers/

# 1. Entry files: Never cache index.html or root so new deployments are served instantly to all users
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# 2. Immutable hashed static assets: Cache forever (1 year) because the filename changes on every build
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 3. API endpoints & server functions: Never cache API responses at the edge
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
