rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.admin == true ||
         request.auth.token.email == 'shsvirtualadmin@gmail.com' ||
         request.auth.token.email == 'support@boardly.cfd');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin())
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'starter' || request.resource.data.plan == 'free' || isAdmin());

      allow update: if (isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan'])))
        || isAdmin();

      allow delete: if isAdmin();

      match /testAttempts/{attemptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /boardyChats/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read approved reviews, student can read their own, admin can read all
      allow read: if (resource.data.status == 'approved')
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || isAdmin();

      // Submit: Logged in, verified email, only with own uid, initial status MUST be pending
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 500;

      // Update by student: editing resets status to 'pending'
      // Update by admin: can approve or reject, but CANNOT approve their own review
      allow update: if (
          isAuthenticated()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 500
        ) || (
          isAdmin()
          // Self-approval check: admin cannot approve their own review
          && !(resource.data.uid == request.auth.uid && request.resource.data.status == 'approved')
        );

      allow delete: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // App config
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testPapers/{paperId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Platform-wide Events (Blitz & Arena)
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community Study Circles
    match /studyCircles/{circleId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAuthenticated() || isAdmin();
    }

    // Campus Captains CRM Applications
    match /captainApplications/{appId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
