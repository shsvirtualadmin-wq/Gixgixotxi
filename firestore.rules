rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE AUTH, ROLE & VALIDATION HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Super Admin check: hardcoded UIDs, verified Super Admin emails, or custom token claims.
    // Never trusts client-writable fields on /users/{uid}.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'jJfb1nThG1X9phL8fFDZ0G0J7m33' ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2' ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'shsvirtualadmin@gmail.com',
            'support@boardly.cfd',
            'support@scholario.me',
            'shs.academy.virtual@gmail.com',
            'scholariosupport@gmail.com'
          ]
        ) ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.role == 'Super Admin'
      );
    }

    // Trusted Admin check: Super Admin, custom claims, /admins/{uid} document, or locked /users/{uid}.role.
    // A regular user can never self-assign admin status because /admins is Super Admin write-only
    // and /users/{uid}.role is locked in unchanged() on client updates.
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in [
            'admin',
            'superadmin',
            'Super Admin'
          ]
        )
      );
    }

    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.moderator == true ||
        request.auth.token.role == 'moderator' ||
        request.auth.token.role == 'Moderator' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in [
            'moderator',
            'Moderator',
            'admin',
            'superadmin',
            'Super Admin'
          ]
        )
      );
    }

    // Captain role check (admin-assigned via /users/{uid}.role, /users/{uid}.isCaptain, or /captains/{uid})
    function isCaptain() {
      return isSignedIn() && (
        request.auth.token.role in ['captain', 'Captain', 'Arena Host'] ||
        exists(/databases/$(database)/documents/captains/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in [
              'captain',
              'Captain',
              'Arena Host'
            ] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isCaptain', false) == true
          )
        )
      );
    }

    function isCaptainOrAdmin() {
      return isAdmin() || isCaptain();
    }

    // Field diff helpers
    function hasOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 &&
        email.size() <= 320 &&
        email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isReservedOfficialName(name) {
      return name is string &&
        name.lower().matches('.*(boardly|super\\s*admin|official|moderator|system|staff|support).*');
    }

    // Computes the maximum pre-existing Koban balance for userId across /users/{userId} and /wallets/{userId}
    // so Store purchases can deduct and synchronize both documents without ever allowing a client-side balance increase.
    function maxExistingUserKobans(userId, userResourceData) {
      let uKobans = userResourceData != null && userResourceData.get('kobans', 0) is number
        ? userResourceData.get('kobans', 0)
        : 0;
      let uBal = userResourceData != null && userResourceData.get('kobanBalance', 0) is number
        ? userResourceData.get('kobanBalance', 0)
        : 0;
      let uMax = uKobans >= uBal ? uKobans : uBal;
      let wMax = exists(/databases/$(database)/documents/wallets/$(userId)) &&
        get(/databases/$(database)/documents/wallets/$(userId)).data.get('balance', 0) is number
        ? get(/databases/$(database)/documents/wallets/$(userId)).data.get('balance', 0)
        : 0;
      return uMax >= wMax ? uMax : wMax;
    }

    function maxExistingWalletKobans(userId, walletResourceData) {
      let wBal = walletResourceData != null && walletResourceData.get('balance', 0) is number
        ? walletResourceData.get('balance', 0)
        : 0;
      let uKobans = exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('kobans', 0) is number
        ? get(/databases/$(database)/documents/users/$(userId)).data.get('kobans', 0)
        : 0;
      let uBal = exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('kobanBalance', 0) is number
        ? get(/databases/$(database)/documents/users/$(userId)).data.get('kobanBalance', 0)
        : 0;
      let uMax = uKobans >= uBal ? uKobans : uBal;
      return wBal >= uMax ? wBal : uMax;
    }

    // Checks if followerUid follows targetUid across follows or user/publicProfile subcollections
    function isFollowingUser(followerUid, targetUid) {
      return exists(/databases/$(database)/documents/follows/$(followerUid + '_' + targetUid)) ||
        exists(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid)) ||
        exists(/databases/$(database)/documents/publicProfiles/$(followerUid)/following/$(targetUid));
    }

    function isMutualFollow(uidA, uidB) {
      return uidA is string &&
        uidB is string &&
        uidA != uidB &&
        isFollowingUser(uidA, uidB) &&
        isFollowingUser(uidB, uidA);
    }

    function hasAcceptedChatRequest(uidA, uidB) {
      return uidA is string &&
        uidB is string &&
        uidA != uidB &&
        (
          (
            exists(/databases/$(database)/documents/chatRequests/$(uidA + '_' + uidB)) &&
            get(/databases/$(database)/documents/chatRequests/$(uidA + '_' + uidB)).data.get('status', '') == 'accepted'
          ) ||
          (
            exists(/databases/$(database)/documents/chatRequests/$(uidB + '_' + uidA)) &&
            get(/databases/$(database)/documents/chatRequests/$(uidB + '_' + uidA)).data.get('status', '') == 'accepted'
          )
        );
    }

    function canUsersChat(uidA, uidB) {
      return isAdmin() || isMutualFollow(uidA, uidB) || hasAcceptedChatRequest(uidA, uidB);
    }

    function isValidFollowCountDelta() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['followersCount', 'followingCount', 'updatedAt']) &&
        (
          !changed.hasAny(['followersCount']) ||
          (
            request.resource.data.followersCount is number &&
            request.resource.data.followersCount >= 0 &&
            request.resource.data.followersCount - resource.data.get('followersCount', 0) >= -1 &&
            request.resource.data.followersCount - resource.data.get('followersCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['followingCount']) ||
          (
            request.resource.data.followingCount is number &&
            request.resource.data.followingCount >= 0 &&
            request.resource.data.followingCount - resource.data.get('followingCount', 0) >= -1 &&
            request.resource.data.followingCount - resource.data.get('followingCount', 0) <= 1
          )
        );
    }

    function isValidCommonsPostType(t) {
      return t in [
        'question',
        'doubt',
        'notes',
        'resource',
        'past_paper',
        'paper',
        'quiz',
        'mcq',
        'advice',
        'tip',
        'experience',
        'discussion',
        'general',
        'attachment_chunk'
      ];
    }

    function isValidCommonsPostCreate() {
      return request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 950000 &&
        isValidCommonsPostType(request.resource.data.get('type', 'general')) &&
        request.resource.data.isAnonymous is bool &&
        (
          (
            request.resource.data.isAnonymous == true &&
            request.resource.data.get('authorUid', null) == null
          ) ||
          (
            request.resource.data.isAnonymous == false &&
            request.resource.data.authorUid == request.auth.uid &&
            (
              !isReservedOfficialName(request.resource.data.get('authorName', '')) ||
              isAdmin()
            )
          )
        ) &&
        (
          !('tags' in request.resource.data) ||
          (request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ) &&
        (
          !('files' in request.resource.data) ||
          (request.resource.data.files is list && request.resource.data.files.size() <= 5)
        ) &&
        request.resource.data.get('upvotes', 0) == 0 &&
        request.resource.data.get('downvotes', 0) == 0 &&
        request.resource.data.get('views', 0) == 0 &&
        request.resource.data.get('commentCount', 0) == 0 &&
        request.resource.data.get('reportCount', 0) == 0 &&
        request.resource.data.get('isHidden', false) == false &&
        (
          request.resource.data.get('isPinned', false) == false ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('isFeatured', false) == false ||
          isAdmin()
        );
    }

    function isCommonsPostOwnerEditableUpdate(postId) {
      return isSignedIn() &&
        (
          (resource.data.isAnonymous == false && resource.data.authorUid == request.auth.uid) ||
          (
            exists(/databases/$(database)/documents/postsPrivate/$(postId)) &&
            get(/databases/$(database)/documents/postsPrivate/$(postId)).data.authorUid == request.auth.uid
          )
        ) &&
        hasOnly([
          'title',
          'description',
          'subject',
          'chapter',
          'target',
          'tags',
          'files',
          'type',
          'board',
          'classLevel',
          'targetExam',
          'difficulty',
          'searchKeywords',
          'isAnonymous',
          'authorUid',
          'authorName',
          'authorAvatar',
          'authorFrame',
          'authorEquippedAvatar',
          'authorPhotoURL',
          'authorRole',
          'authorCustomRole',
          'updatedAt'
        ]) &&
        (
          (
            request.resource.data.isAnonymous == true &&
            request.resource.data.get('authorUid', null) == null
          ) ||
          (
            request.resource.data.isAnonymous == false &&
            request.resource.data.authorUid == request.auth.uid &&
            (
              !isReservedOfficialName(request.resource.data.get('authorName', '')) ||
              isAdmin()
            )
          )
        ) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 20000 &&
        (
          !('tags' in request.resource.data) ||
          (request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ) &&
        (
          !('files' in request.resource.data) ||
          (request.resource.data.files is list && request.resource.data.files.size() <= 5)
        );
    }

    function isCommonsPostCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() &&
        changed.hasOnly([
          'upvotes',
          'downvotes',
          'views',
          'commentCount',
          'commentsCount',
          'savesCount',
          'saveCount',
          'reportCount',
          'isHidden',
          'updatedAt'
        ]) &&
        (
          !changed.hasAny(['upvotes']) ||
          (
            request.resource.data.upvotes is number &&
            request.resource.data.upvotes >= 0 &&
            request.resource.data.upvotes - resource.data.get('upvotes', 0) >= -1 &&
            request.resource.data.upvotes - resource.data.get('upvotes', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['downvotes']) ||
          (
            request.resource.data.downvotes is number &&
            request.resource.data.downvotes >= 0 &&
            request.resource.data.downvotes - resource.data.get('downvotes', 0) >= -1 &&
            request.resource.data.downvotes - resource.data.get('downvotes', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['commentCount']) ||
          (
            request.resource.data.commentCount is number &&
            request.resource.data.commentCount >= 0 &&
            request.resource.data.commentCount - resource.data.get('commentCount', 0) >= -1 &&
            request.resource.data.commentCount - resource.data.get('commentCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['commentsCount']) ||
          (
            request.resource.data.commentsCount is number &&
            request.resource.data.commentsCount >= 0 &&
            request.resource.data.commentsCount - resource.data.get('commentsCount', 0) >= -1 &&
            request.resource.data.commentsCount - resource.data.get('commentsCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['views']) ||
          (
            request.resource.data.views is number &&
            request.resource.data.views >= resource.data.get('views', 0) &&
            request.resource.data.views - resource.data.get('views', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['savesCount']) ||
          (
            request.resource.data.savesCount is number &&
            request.resource.data.savesCount >= 0 &&
            request.resource.data.savesCount - resource.data.get('savesCount', 0) >= -1 &&
            request.resource.data.savesCount - resource.data.get('savesCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['saveCount']) ||
          (
            request.resource.data.saveCount is number &&
            request.resource.data.saveCount >= 0 &&
            request.resource.data.saveCount - resource.data.get('saveCount', 0) >= -1 &&
            request.resource.data.saveCount - resource.data.get('saveCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['reportCount']) ||
          (
            request.resource.data.reportCount is number &&
            request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
          )
        ) &&
        (
          !changed.hasAny(['isHidden']) ||
          isAdmin() ||
          isModerator() ||
          (
            request.resource.data.isHidden == true &&
            request.resource.data.get('reportCount', 0) >= 3
          )
        );
    }

    // =========================================================================
    // 2. ADMINS COLLECTION
    // =========================================================================

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. USERS & PRIVATE SUBCOLLECTIONS
    // =========================================================================

    match /users/{userId} {
      allow get: if isSignedIn();
      // Signed-in users can execute bounded queries (e.g. username availability, shortId/referral lookup);
      // full collection listing is restricted to admins.
      allow list: if isAdmin() || (isSignedIn() && request.query.limit != null && request.query.limit <= 25);

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('uid', userId) == userId &&
        (!('email' in request.resource.data) || request.resource.data.email == null || isValidEmail(request.resource.data.email)) &&
        request.resource.data.get('role', 'student') in ['student', 'Student'] &&
        request.resource.data.get('plan', 'free') == 'free' &&
        request.resource.data.get('tier', 'free') == 'free' &&
        request.resource.data.get('paid_until', null) == null &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('isSuperAdmin', false) == false &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isBanned', false) == false &&
        request.resource.data.get('isSuspended', false) == false &&
        request.resource.data.get('suspended', false) == false &&
        request.resource.data.get('status', 'active') == 'active' &&
        request.resource.data.get('kobans', 0) == 0 &&
        request.resource.data.get('kobanBalance', 0) == 0 &&
        (
          !isReservedOfficialName(request.resource.data.get('displayName', '')) ||
          isAdmin()
        )
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        unchanged([
          'uid',
          'role',
          'isAdmin',
          'isSuperAdmin',
          'plan',
          'tier',
          'paid_until',
          'subscriptionStatus',
          'isVerified',
          'verified',
          'isBanned',
          'isSuspended',
          'suspended',
          'status',
          'coins',
          'xp',
          'isCaptain',
          'captainCode',
          'permissions'
        ]) &&
        (
          unchanged(['kobans', 'kobanBalance']) ||
          (
            request.resource.data.get('kobans', 0) is number &&
            request.resource.data.get('kobans', 0) >= 0 &&
            request.resource.data.get('kobans', 0) <= maxExistingUserKobans(userId, resource.data) &&
            request.resource.data.get('kobanBalance', 0) is number &&
            request.resource.data.get('kobanBalance', 0) >= 0 &&
            request.resource.data.get('kobanBalance', 0) <= maxExistingUserKobans(userId, resource.data)
          )
        ) &&
        (
          unchanged(['displayName']) ||
          !isReservedOfficialName(request.resource.data.get('displayName', ''))
        )
      ) || (
        isSignedIn() &&
        isValidFollowCountDelta()
      );

      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /unlocked/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin() || (
          isOwner(userId) &&
          request.resource.data.get('itemId', itemId) == itemId &&
          request.resource.data.get('pricePaid', 0) is number &&
          request.resource.data.get('pricePaid', 0) >= 0
        );
        allow delete: if isAdmin();
      }

      match /inventory/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Daily limit counters are strictly read-only for clients (only when request.auth.uid == userId).
      // All increments and daily limit verifications happen server-side.
      match /usage/{dateKey} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }

      match /activity/{dateKey} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /chapterStats/{chapterId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedCommons/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /readAnnouncements/{announcementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
      }

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 4. PUBLIC PROFILES, USERNAMES & SOCIAL GRAPH
    // =========================================================================

    match /publicProfiles/{userId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('uid', userId) == userId &&
        request.resource.data.get('role', 'student') in ['student', 'Student'] &&
        request.resource.data.get('isVerified', false) == false &&
        !isReservedOfficialName(request.resource.data.get('displayName', ''))
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        unchanged([
          'uid',
          'role',
          'isVerified',
          'verified',
          'badges',
          'isCaptain'
        ]) &&
        (
          unchanged(['displayName']) ||
          !isReservedOfficialName(request.resource.data.get('displayName', ''))
        )
      ) || (
        isSignedIn() &&
        isValidFollowCountDelta()
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /followers/{followerUid} {
        allow read: if true;
        allow create, update: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
      }

      match /following/{targetUid} {
        allow read: if true;
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId is string &&
        request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid ||
        isAdmin()
      );
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        usernameLower.size() >= 3 &&
        usernameLower.size() <= 24 &&
        usernameLower.matches('^[a-z0-9_.]+$') &&
        !isReservedOfficialName(usernameLower);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );
    }

    match /nameRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        !isReservedOfficialName(request.resource.data.get('requestedName', ''));
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. WALLETS, KOBAN ECONOMY & BOARDLY STORE
    // =========================================================================

    match /wallets/{userId} {
      allow get: if isSignedIn();
      allow list: if isOwner(userId) || isAdmin();

      // Users can initialize or update their own wallet ONLY when the new balance is <= their existing balance
      // across /wallets/{userId} and /users/{userId}. Clients can never increase their own Koban balance.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('balance', 0) is number &&
        request.resource.data.get('balance', 0) >= 0 &&
        request.resource.data.get('balance', 0) <= maxExistingWalletKobans(userId, null)
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        hasOnly(['uid', 'userId', 'balance', 'owned', 'equipped', 'updatedAt']) &&
        request.resource.data.get('balance', 0) is number &&
        request.resource.data.get('balance', 0) >= 0 &&
        request.resource.data.get('balance', 0) <= maxExistingWalletKobans(userId, resource.data)
      );

      allow delete: if isAdmin();

      match /ledger/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin() || (
          isOwner(userId) &&
          request.resource.data.get('type', '') == 'purchase' &&
          request.resource.data.get('amount', 0) is number &&
          request.resource.data.get('amount', 0) <= 0 &&
          request.resource.data.get('balanceAfter', 0) is number &&
          request.resource.data.get('balanceAfter', 0) >= 0
        );
        allow update, delete: if isAdmin();
      }
    }

    match /kobanTransactions/{txId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /kobanRequests/{reqId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /store_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storePriceHistory/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_price_audit/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. PRACTICE ENGINE, QUESTIONS, TESTS & STREAKS
    // =========================================================================

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('studentUid', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid ||
        request.resource.data.get('studentUid', '') == request.auth.uid
      );
      // Students can update their own in-progress attempt until it is submitted (status == 'completed');
      // once completed, only admins can modify or regrade it.
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('studentUid', '') == request.auth.uid
        ) &&
        resource.data.get('status', 'in_progress') != 'completed' &&
        unchanged(['userId', 'uid', 'studentUid'])
      );
      allow delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isSignedIn() || resource.data.get('visibility', 'public') == 'public' || resource.data.get('isPublic', true) == true;
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('creatorId', '') == request.auth.uid ||
        request.resource.data.get('captainUid', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isCaptainOrAdmin() &&
        (
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
    }

    match /testResults/{resultId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('studentUid', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid ||
        request.resource.data.get('studentUid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /streaks/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.get('status', 'published') == 'published' ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /questions_mathematics/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_physics/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_chemistry/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_biology/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_english/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_computer/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_intelligence/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_general/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questionKeys/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /question_index/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questionReports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('reporterUid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin() || isModerator();
    }

    // =========================================================================
    // 7. AMBASSADOR / CAPTAIN / GRAND LINE SYSTEM
    // =========================================================================

    match /ambassador_tests/{testId} {
      allow read: if isAdmin() ||
        resource == null ||
        resource.data.get('visibility', 'public') == 'public' ||
        resource.data.get('isPublic', true) == true ||
        (
          isSignedIn() &&
          (
            resource.data.get('creatorId', '') == request.auth.uid ||
            resource.data.get('captainUid', '') == request.auth.uid ||
            resource.data.get('visibility', 'public') == 'private'
          )
        );
      allow create: if isCaptainOrAdmin() &&
        (
          request.resource.data.get('creatorId', '') == request.auth.uid ||
          request.resource.data.get('captainUid', '') == request.auth.uid
        ) &&
        request.resource.data.get('title', '') is string &&
        request.resource.data.get('title', '').size() >= 1 &&
        request.resource.data.get('title', '').size() <= 200 &&
        request.resource.data.get('visibility', 'public') in ['public', 'private'] &&
        request.resource.data.get('questionCount', 0) is number &&
        request.resource.data.get('questionCount', 0) >= 0 &&
        request.resource.data.get('questionCount', 0) <= 200;
      allow update: if isAdmin() || (
        isCaptainOrAdmin() &&
        (
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      ) || (
        isSignedIn() &&
        hasOnly(['attemptsCount', 'participantCount', 'avgScore', 'updatedAt'])
      );
      allow delete: if isAdmin() || (
        isCaptainOrAdmin() &&
        (
          resource.data.get('creatorId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
    }

    match /ambassador_test_attempts/{attemptId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userUid', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid ||
        resource.data.get('captainUid', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userUid', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid ||
        resource.data.get('captainUid', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('studentUid', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('userUid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /captain_tests/{testId} {
      allow read: if true;
      allow create: if isCaptainOrAdmin() &&
        (
          request.resource.data.get('captainUid', '') == request.auth.uid ||
          request.resource.data.get('creatorId', '') == request.auth.uid
        );
      allow update, delete: if isAdmin() || (
        isCaptainOrAdmin() &&
        (
          resource.data.get('captainUid', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid
        )
      );
    }

    match /captain_test_questions/{qId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCaptainOrAdmin();
    }

    match /captain_test_results/{resultId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('userUid', '') == request.auth.uid ||
        resource.data.get('captainUid', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('studentUid', '') == request.auth.uid ||
        request.resource.data.get('userUid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /grand_line_leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /captainApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(appId) ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(appId) ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /captains/{captainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(referralId) ||
          resource.data.get('referredUid', '') == request.auth.uid ||
          resource.data.get('referredUserId', '') == request.auth.uid ||
          resource.data.get('referrerUid', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid ||
          resource.data.get('referrerId', '') == request.auth.uid ||
          resource.data.get('ambassadorId', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(referralId) ||
          request.resource.data.get('referredUid', '') == request.auth.uid ||
          request.resource.data.get('referredUserId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. BOARDLY COMMONS (FIRESTORE PARTS ONLY; CLOUDFLARE D1/R2 UNTOUCHED)
    // =========================================================================

    match /commonsPosts/{postId} {
      allow get: if resource == null ||
        resource.data.get('isHidden', false) == false ||
        (isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid) ||
        isAdmin() ||
        isModerator();

      allow list: if isSignedIn() ||
        resource == null ||
        resource.data.get('isHidden', false) == false ||
        isAdmin() ||
        isModerator();

      allow create: if isSignedIn() && isValidCommonsPostCreate();

      allow update: if isAdmin() ||
        isModerator() ||
        isCommonsPostOwnerEditableUpdate(postId) ||
        isCommonsPostCounterUpdate();

      allow delete: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          (
            (resource.data.isAnonymous == false && resource.data.authorUid == request.auth.uid) ||
            (
              exists(/databases/$(database)/documents/postsPrivate/$(postId)) &&
              get(/databases/$(database)/documents/postsPrivate/$(postId)).data.authorUid == request.auth.uid
            )
          )
        );

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if isOwner(voterId) &&
          request.resource.data.get('uid', voterId) == voterId &&
          request.resource.data.get('value', 1) in [-1, 1];
        allow delete: if isOwner(voterId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() &&
          (
            (
              request.resource.data.get('text', '') is string &&
              request.resource.data.get('text', '').size() >= 1 &&
              request.resource.data.get('text', '').size() <= 3000
            ) ||
            (
              request.resource.data.get('body', '') is string &&
              request.resource.data.get('body', '').size() >= 1 &&
              request.resource.data.get('body', '').size() <= 3000
            )
          ) &&
          request.resource.data.get('isAnonymous', false) is bool &&
          (
            (
              request.resource.data.get('isAnonymous', false) == true &&
              request.resource.data.get('authorUid', null) == null
            ) ||
            (
              request.resource.data.get('isAnonymous', false) == false &&
              request.resource.data.authorUid == request.auth.uid
            )
          );

        allow update: if isAdmin() ||
          isModerator() ||
          (
            isSignedIn() &&
            resource.data.get('isAnonymous', false) == false &&
            resource.data.authorUid == request.auth.uid &&
            hasOnly(['text', 'body', 'updatedAt'])
          );

        allow delete: if isAdmin() ||
          isModerator() ||
          (
            isSignedIn() &&
            (
              (resource.data.get('isAnonymous', false) == false && resource.data.authorUid == request.auth.uid) ||
              (
                exists(/databases/$(database)/documents/postsPrivate/$(commentId)) &&
                get(/databases/$(database)/documents/postsPrivate/$(commentId)).data.authorUid == request.auth.uid
              )
            )
          );
      }
    }

    match /commonsAttachments/{chunkId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.fileId is string &&
        request.resource.data.chunkIndex is number &&
        request.resource.data.totalChunks is number &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 950000;
      allow update: if false;
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /postsPrivate/{docId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );
      allow list: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.authorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == request.auth.uid
        );
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /postPrivate/{docId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );
      allow list: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.authorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /commonsReports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 2 &&
        request.resource.data.reason.size() <= 1000 &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin() || isModerator();
    }

    // =========================================================================
    // 9. USER FEED POSTS (/posts)
    // =========================================================================

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (
          request.resource.data.get('authorUid', '') == request.auth.uid &&
          request.resource.data.get('content', '') is string &&
          request.resource.data.get('content', '').size() <= 5000 &&
          request.resource.data.get('likesCount', 0) == 0 &&
          request.resource.data.get('commentsCount', 0) == 0
        ) ||
        (
          request.resource.data.get('authorUid', '') == request.auth.uid &&
          request.resource.data.get('fileId', '') is string &&
          request.resource.data.get('data', '') is string &&
          request.resource.data.get('data', '').size() <= 950000
        )
      );

      allow update: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          resource.data.authorUid == request.auth.uid &&
          hasOnly([
            'content',
            'subjectTag',
            'attachmentUrl',
            'attachmentType',
            'attachmentName',
            'updatedAt'
          ])
        ) ||
        (
          isSignedIn() &&
          hasOnly(['likesCount', 'commentsCount', 'updatedAt'])
        );

      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);

      match /likes/{likeId} {
        allow read: if true;
        allow create, update: if isOwner(likeId);
        allow delete: if isOwner(likeId) || isAdmin();
      }
    }

    // =========================================================================
    // 10. STUDY BUDDY, CHAT & NOTIFICATIONS
    // =========================================================================

    match /study_buddy_presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isOwner(presenceId) ||
        request.resource.data.get('uid', '') == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        isOwner(presenceId) ||
        resource.data.get('uid', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /study_buddy_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.get('uid', '') == request.auth.uid ||
        request.resource.data.get('studentUid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isSignedIn() && (
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('studentUid', '') == request.auth.uid
        )
      );
    }

    match /study_buddy_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.get('senderUid', '') == request.auth.uid &&
        request.resource.data.get('text', '') is string &&
        request.resource.data.get('text', '').size() >= 1 &&
        request.resource.data.get('text', '').size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.get('senderUid', '') == request.auth.uid
      );
    }

    match /chatRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid.size() > 0 &&
        request.resource.data.toUid != request.auth.uid &&
        requestId == (request.resource.data.fromUid + '_' + request.resource.data.toUid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.status in ['accepted', 'declined'] &&
        (
          request.resource.data.status == 'accepted' ||
          request.resource.data.declinedAt is timestamp
        )
      ) || (
        isSignedIn() &&
        resource.data.fromUid == request.auth.uid &&
        resource.data.status == 'declined' &&
        resource.data.declinedAt is timestamp &&
        request.time > resource.data.declinedAt + duration.value(24, 'h') &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp
      );

      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.get('participants', []) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        canUsersChat(request.resource.data.participants[0], request.resource.data.participants[1]);

      allow update: if isSignedIn() &&
        resource.data.participants is list &&
        resource.data.participants.size() == 2 &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        canUsersChat(resource.data.participants[0], resource.data.participants[1]);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', [])
          )
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 1000 &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('participants', []) &&
          canUsersChat(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
          );
        allow update, delete: if isAdmin();
      }
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('recipientUid', '') == request.auth.uid
        ) &&
        hasOnly(['read', 'isRead', 'readAt'])
      ) || (
        // Allow idempotent setDoc(..., { merge: true }) by the notification sender on deterministic notification IDs
        isSignedIn() &&
        (
          resource.data.get('authorId', '') == request.auth.uid ||
          resource.data.get('actorId', '') == request.auth.uid ||
          resource.data.get('followerId', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('recipientUid', '') == request.auth.uid
        )
      );
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. PAYMENTS, CREWS, ARENA, PROMOS, REVIEWS, SUPPORT & AUDIT LOGS
    // =========================================================================

    match /paymentRequests/{requestId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /crews/{crewId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        (
          request.resource.data.get('leaderId', '') == request.auth.uid ||
          request.resource.data.get('captainUid', '') == request.auth.uid ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('tier', 'free') == 'free' ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('paid_until', null) == null ||
          isAdmin()
        );

      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('leaderId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        ) &&
        unchanged([
          'tier',
          'paid_until',
          'leaderId',
          'isVerified'
        ]) &&
        (
          unchanged(['maxMembers']) ||
          (
            resource.data.get('tier', 'free') == 'paid' &&
            request.resource.data.maxMembers is number &&
            request.resource.data.maxMembers >= 1 &&
            request.resource.data.maxMembers <= 50
          ) ||
          (
            resource.data.get('tier', 'free') != 'paid' &&
            request.resource.data.maxMembers is number &&
            request.resource.data.maxMembers >= 1 &&
            request.resource.data.maxMembers <= 5
          )
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('leaderId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );

      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create, update: if isAdmin() || isOwner(memberUid) || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/crews/$(crewId)) &&
          (
            get(/databases/$(database)/documents/crews/$(crewId)).data.get('leaderId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/crews/$(crewId)).data.get('captainUid', '') == request.auth.uid
          )
        );
        allow delete: if isAdmin() || isOwner(memberUid) || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/crews/$(crewId)) &&
          (
            get(/databases/$(database)/documents/crews/$(crewId)).data.get('leaderId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/crews/$(crewId)).data.get('captainUid', '') == request.auth.uid
          )
        );
      }
    }

    match /crew_members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isCaptainOrAdmin() || (
        isSignedIn() &&
        (
          request.resource.data.get('userUid', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || isCaptainOrAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userUid', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid ||
          resource.data.get('leaderId', '') == request.auth.uid
        )
      );
    }

    match /crew_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid ||
          request.resource.data.get('studentUid', '') == request.auth.uid
        );
      allow update, delete: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('leaderId', '') == request.auth.uid ||
        resource.data.get('captainUid', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /crewApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(appId) ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(appId) ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /programApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(appId) ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(appId) ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /applications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(appId) ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(appId) ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /arenaRegistrations/{regId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /arenaLeaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.get('status', 'approved') == 'approved' ||
        (isSignedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('rating', 5) is number &&
        request.resource.data.get('rating', 5) >= 1 &&
        request.resource.data.get('rating', 5) <= 5;
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.get('userId', '') == request.auth.uid
      );
    }

    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() >= 2 &&
        request.resource.data.get('message', '').size() <= 5000;
      allow update, delete: if isAdmin();
    }

    match /contact_inquiries/{msgId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() >= 2 &&
        request.resource.data.get('message', '').size() <= 5000;
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // Append-only Admin Audit Log: readable and creatable by Admin only; never editable or deletable
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Transactional Email Dispatch Logs (Resend): readable and updatable (retry status) by Admin;
    // creatable by Admin or the authenticated actor whose userId matches the dispatch log.
    match /email_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('eventType', '') is string &&
        request.resource.data.get('eventType', '').size() <= 80 &&
        request.resource.data.get('status', 'sent') in ['sent', 'failed', 'skipped']
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // 12. CATALOG, SESSIONS, MISSIONS, REWARDS & CERTIFICATES
    // =========================================================================

    match /sheets/{sheetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /universities/{uniId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meritFormulas/{formulaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessionResults/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /crewEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /crewEventAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if isSignedIn() && (
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('student_uid', '') == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /certificateSignatures/{sigId} {
      allow read, write: if isAdmin();
    }

    match /organizers/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizerApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          isOwner(appId) ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          isOwner(appId) ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    // Server-side Rewards Engine fallback collections (managed via /api/rewards/* and Admin)
    match /reward_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /reward_codes/{codeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reward_redemptions/{redemptionId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.get('uid', '') == request.auth.uid
      );
      allow write: if isAdmin();
    }

    match /reward_events/{eventId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.get('uid', '') == request.auth.uid
      );
      allow write: if isAdmin();
    }

    match /reward_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // 13. EXPLICIT DEFAULT DENY CATCH-ALL
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
