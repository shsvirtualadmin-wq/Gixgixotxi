rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE SECURITY HELPERS
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSignedIn() {
      return signedIn();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email != null &&
          request.auth.token.email.lower() == 'shsvirtualadmin@gmail.com'
        ) ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2' ||
        request.auth.uid == 'jJfb1nThG1X9phL8fFDZ0G0J7m33' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        (
          request.auth.token.email != null &&
          request.auth.token.email.lower() in [
            'shsvirtualadmin@gmail.com',
            'support@boardly.cfd',
            'support@scholario.me'
          ]
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        )
      );
    }

    // Blocks owner updates to any protected billing, plan, tier, wallet, or role fields
    function ownerUpdatesOnlySafeUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan',
        'tier',
        'kobans',
        'kobanBalance',
        'role',
        'proUntil',
        'paid_until',
        'planExpiresAt',
        'premiumExpiresAt',
        'isPremium',
        'proPlanId',
        'premiumSource',
        'isAdmin',
        'isSuperAdmin',
        'isBanned',
        'isSuspended',
        'suspended',
        'status',
        'permissions'
      ]);
    }

    // Blocks owner from creating a user doc with elevated plan, tier, kobans, role, or proUntil
    function ownerCreatesOnlySafeUserFields() {
      return (
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        (!('tier' in request.resource.data) || request.resource.data.tier == 'free') &&
        (!('kobans' in request.resource.data) || request.resource.data.kobans == 0) &&
        (!('kobanBalance' in request.resource.data) || request.resource.data.kobanBalance == 0) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user']) &&
        (!('proUntil' in request.resource.data) || request.resource.data.proUntil == null) &&
        (!('paid_until' in request.resource.data) || request.resource.data.paid_until == null) &&
        (!('planExpiresAt' in request.resource.data) || request.resource.data.planExpiresAt == null) &&
        (!('premiumExpiresAt' in request.resource.data) || request.resource.data.premiumExpiresAt == null) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
        (!('proPlanId' in request.resource.data) || request.resource.data.proPlanId == null) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false)
      );
    }

    // Validates that any updated avatar / avatarId / equippedAvatar is either in the free system avatar allowlist or in the user's owned items
    function isFreeSystemAvatar(avatarVal) {
      return avatarVal == null || avatarVal == '' || avatarVal == 'none' || avatarVal in [
        'skull-01', 'skull-02',
        'robot-01', 'robot-02', 'robot-03',
        'animal-01', 'animal-02', 'animal-03',
        'flame-01', 'flame-02',
        'bolt-01', 'bolt-02',
        'star-01', 'star-02',
        'shield-01', 'shield-02',
        'crown-01', 'crown-02',
        'planet-01', 'planet-02',
        'science-01', 'science-02',
        'glyph-01', 'glyph-02', 'glyph-03', 'glyph-04', 'glyph-05', 'glyph-06'
      ];
    }

    function isAllowedUserAvatar(uid, avatarVal) {
      return isFreeSystemAvatar(avatarVal) ||
        (
          exists(/databases/$(database)/documents/wallets/$(uid)) &&
          'owned' in get(/databases/$(database)/documents/wallets/$(uid)).data &&
          avatarVal in get(/databases/$(database)/documents/wallets/$(uid)).data.owned
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          'ownedCosmetics' in get(/databases/$(database)/documents/users/$(uid)).data &&
          avatarVal in get(/databases/$(database)/documents/users/$(uid)).data.ownedCosmetics
        ) ||
        exists(/databases/$(database)/documents/users/$(uid)/unlocked/$(avatarVal));
    }

    function validAvatarFieldsForUser(uid, data) {
      return (!('avatar' in data) || isAllowedUserAvatar(uid, data.avatar)) &&
        (!('avatarId' in data) || isAllowedUserAvatar(uid, data.avatarId)) &&
        (!('equippedAvatar' in data) || isAllowedUserAvatar(uid, data.equippedAvatar)) &&
        (!('equipped' in data) || !(data.equipped is map) || !('avatar' in data.equipped) || isAllowedUserAvatar(uid, data.equipped.avatar));
    }

    // =========================================================================
    // 1. USERS & USER SUBCOLLECTIONS
    // =========================================================================
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isOwner(userId) && ownerCreatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data));
      allow update: if isAdmin() ||
        (isOwner(userId) && ownerUpdatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data)) ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'updatedAt']));
      allow delete: if isAdmin();

      // Inventory & Unlocked Cosmetics: owner or admin read, server/admin write only
      match /inventory/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /unlocked/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // User Notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if signedIn();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // Followers / Following subcollections
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, update: if isAdmin() || isOwner(followerUid) || isOwner(userId);
        allow delete: if isAdmin() || isOwner(followerUid) || isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || isOwner(userId);
      }

      // User Progress, Attempts, Bookmarks, Settings, Stats, Reward History
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /SavedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /stats/{statId} {
        allow read: if signedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /rewardHistory/{claimId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /dailyClaims/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // 2. PAYMENTS & KOBAN TOP-UP REQUESTS
    //    Own-uid create only with status == "pending", own or admin read,
    //    admin-only update/delete.
    // =========================================================================
    match /paymentRequests/{requestId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /kobanRequests/{reqId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. COUPON REDEMPTIONS
    //    Own-uid create only, own or admin read, admin-only update/delete.
    // =========================================================================
    match /couponRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 4. COUPONS & STORE ITEMS
    //    Signed-in read, admin write.
    // =========================================================================
    match /coupons/{couponId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /storeItems/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /store_items/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. INVENTORY & WALLETS
    //    Inventory: owner or admin read, server/admin write only.
    //    Wallets: owner or admin read; server/admin writes balances & owned;
    //    owner may only update equipped cosmetics or initialize a 0-balance doc.
    // =========================================================================
    match /inventory/{docId} {
      allow read: if isAdmin() || (
        signedIn() && (
          docId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('balance' in request.resource.data) || request.resource.data.balance == 0) &&
        (!('owned' in request.resource.data) || request.resource.data.owned.size() == 0) &&
        validAvatarFieldsForUser(userId, request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped', 'updatedAt']) &&
        validAvatarFieldsForUser(userId, request.resource.data)
      );
      allow delete: if isAdmin();

      match /ledger/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // 6. POSTS (Boardly Commons)
    //    Signed-in (and public published) reads, owner-scoped writes.
    // =========================================================================
    match /commonsPosts/{postId} {
      allow read: if signedIn() || resource.data.status == 'published';
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount',
            'likedBy',
            'commentsCount',
            'savesCount',
            'savedBy',
            'viewsCount',
            'downloadsCount',
            'sharesCount',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );

      match /comments/{commentId} {
        allow read: if signedIn() || true;
        allow create: if signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
        allow update, delete: if isAdmin() || (
          signedIn() && (
            resource.data.authorId == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            resource.data.uid == request.auth.uid
          )
        );
      }

      match /likes/{likeUid} {
        allow read: if signedIn() || true;
        allow create, update, delete: if isOwner(likeUid) || isAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if signedIn() || resource.data.status == 'published';
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 7. CREWS, CREW MEMBERS & CREW REQUESTS
    //    Signed-in reads, owner/member-scoped writes (blocking protected tier/paid_until).
    // =========================================================================
    match /crews/{crewId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.createdBy == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.captainId == request.auth.uid
        ) &&
        (!('tier' in request.resource.data) || request.resource.data.tier == 'free') &&
        (!('paid_until' in request.resource.data) || request.resource.data.paid_until == null)
      );
      allow update: if isAdmin() || (
        signedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'paid_until']) &&
        (
          resource.data.createdBy == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.captainId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members',
            'memberUids',
            'memberCount',
            'hasProMember',
            'updatedAt',
            'weeklyXp',
            'totalXp',
            'score'
          ])
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.captainId == request.auth.uid
        )
      );

      match /{subCol}/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() || isAdmin();
      }
    }

    match /crew_members/{memberId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn() && (
          memberId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          memberId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    match /crew_requests/{requestId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.fromUid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid ||
          resource.data.captainId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 8. FOLLOWS & NOTIFICATIONS
    //    Signed-in reads, owner-scoped writes.
    // =========================================================================
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.followerId == request.auth.uid ||
          request.resource.data.followerUid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.followerId == request.auth.uid ||
          resource.data.followerUid == request.auth.uid ||
          resource.data.followingId == request.auth.uid ||
          resource.data.followingUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.actorId == request.auth.uid ||
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 9. SUPPORTING APPLICATION COLLECTIONS (Preserved)
    // =========================================================================
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user']) &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        validAvatarFieldsForUser(userId, request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user']) &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        validAvatarFieldsForUser(userId, request.resource.data)
      ) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'updatedAt'])
      );
      allow delete: if isAdmin();

      match /followers/{followerUid} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isOwner(followerUid) || isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isOwner(userId);
      }
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        signedIn() && request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
      );
    }

    match /referrals/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /testAttempts/{attemptId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /user_events/{eventId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /dailySnapshots/{snapshotId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mcqs/{mcqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mcq_banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pastPapers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /supportRequests/{reqId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 10. FINAL CATCH-ALL: ADMIN ONLY
    // =========================================================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
