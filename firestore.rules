rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN OVERRIDE: full access for verified super admin email only
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() == 'shsvirtualadmin@gmail.com';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization rule:
    // Strictly verified: auth email lowercased === "shsvirtualadmin@gmail.com" is the ONLY admin.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'shsvirtualadmin@gmail.com';
    }

    // Forbidden student keys on creation or modification
    function studentCreateAllowed(userId) {
      let forbiddenKeys = [
        'roles',
        'isPremium',
        'premium',
        'premiumExpiresAt',
        'premiumSource',
        'previousPlan',
        'isCrewMember',
        'crewStatus',
        'crewStartDate',
        'crewReferralCode',
        'crewRevokedAt',
        'crewRevokeReason',
        'isPaidInternshipEligible',
        'ambassador',
        'admin',
        'isAdmin',
        'suspended',
        'isSuspended'
      ];
      return isOwner(userId)
        && !request.resource.data.keys().hasAny(forbiddenKeys)
        && (!('role' in request.resource.data) || request.resource.data.role == 'student')
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || request.resource.data.plan == 'starter');
    }

    // Protect critical fields (plan, role, premium, premiumSource, ambassador/crew, admin, suspension)
    // Owners cannot change these fields on their own document; only super admin can edit them.
    function userDoesNotChangeProtectedFields() {
      let protectedKeys = [
        'plan',
        'role',
        'roles',
        'isPremium',
        'premium',
        'premiumExpiresAt',
        'premiumSource',
        'previousPlan',
        'isCrewMember',
        'crewStatus',
        'crewStartDate',
        'crewReferralCode',
        'crewRevokedAt',
        'crewRevokeReason',
        'isPaidInternshipEligible',
        'ambassador',
        'admin',
        'isAdmin',
        'suspended',
        'isSuspended'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys);
    }

    // Users collection:
    // Owners can read and update their own document without changing protected admin/plan fields.
    // Authenticated users can read their own profile matching their verified token email.
    // Super admin can list and write any user record.
    match /users/{userId} {
      allow get: if isOwner(userId)
        || isAdmin()
        || (isAuthenticated() && request.auth.token.email != null && (
          resource.data.email == request.auth.token.email ||
          resource.data.email == request.auth.token.email.lower()
        ));
      allow list: if isAdmin();
      allow create: if isAdmin() || studentCreateAllowed(userId);
      allow update: if isAdmin()
        || (isOwner(userId) && userDoesNotChangeProtectedFields())
        || (isAuthenticated() && request.auth.token.email != null && (
          resource.data.email == request.auth.token.email ||
          resource.data.email == request.auth.token.email.lower()
        ) && userDoesNotChangeProtectedFields());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // In-App Notifications: Users read and mark read their own notifications; authenticated users/admins can create
    match /notifications/{notifId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews collection: Approved reviews are public. Authors and admins can manage their own.
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved')
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 800;

      allow update: if (
          isAuthenticated()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
        ) || isAdmin();

      allow delete: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // System configurations and Admin access list
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Payment upgrade requests
    match /paymentRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Competitive event sessions (Blitz, Arena, Study Circles)
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && (resource.data.organizerId == request.auth.uid || request.resource.data.organizerId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Boardly Crew Events:
    // Public read for events. Organizers can manage their own events; admins have full access.
    match /crewEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
    }

    // Boardly Crew Event Attempts:
    // Public read for leaderboard. Authenticated users submit their own attempt.
    match /crewEventAttempts/{attemptId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /sessionResults/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Organizer applications & management
    match /organizerApplications/{appId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /organizers/{orgId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // Campus Captains & Boardly Crew Ambassador Applications:
    match /captainApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && (appId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /crewApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && (appId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Captains / Ambassadors collection:
    // Authenticated users can read captains so registering students can look up the matching ambassador by referral code.
    // Captains can update their own profile; admins can write everything.
    match /captains/{captainId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin() || (isAuthenticated() && captainId == request.auth.uid);
    }

    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid ||
        resource.data.ambassadorUid == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referredUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.referredUserId == request.auth.uid ||
        request.resource.data.referredUid == request.auth.uid ||
        refId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Content: questions, sheets, universities, formulas
    match /questions/{qId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /sheets/{sheetId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /universities/{univId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meritFormulas/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Immutable Audit Logs: read-only by admin, create by authenticated users or admin, no delete/update
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if false;
    }
  }
}
