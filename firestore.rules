rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Superadmin authorization: shsvirtualadmin@gmail.com OR user doc has role == 'admin'
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'shsvirtualadmin@gmail.com' ||
          request.auth.token.email.matches('(?i)shsvirtualadmin@gmail\\.com')
        )) ||
        (request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    // ADMIN OVERRIDE: full read/write for superadmin across all collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users collection:
    // Authenticated users have full read/write for their own user document
    // Superadmins have full read/write/list for all user documents
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Unified applications collection (for Crew & Captain role applications)
    match /applications/{appId} {
      allow read, write: if isAdmin() || (isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || appId == request.auth.uid || request.resource.data.userId == request.auth.uid
      ));
    }

    // Legacy applications collections
    match /captainApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && (appId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /crewApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && (appId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // In-App Notifications: Users read and mark read their own notifications; authenticated users/admins can create
    match /notifications/{notifId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews collection: Approved reviews are public. Authors and admins can manage their own.
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved')
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 800;

      allow update: if (
          isAuthenticated()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
        ) || isAdmin();

      allow delete: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // System configurations and Admin access list
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Payment upgrade requests and payments
    match /paymentRequests/{requestId} {
      allow read, write: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid));
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid));
    }

    // Competitive event sessions (Blitz, Arena, Study Circles)
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && (resource.data.organizerId == request.auth.uid || request.resource.data.organizerId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    // Boardly Crew Events:
    match /crewEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
    }

    // Boardly Crew Event Attempts:
    match /crewEventAttempts/{attemptId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /sessionResults/{resultId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.student_id == request.auth.uid
      ));
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.student_id == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    // MCQ Test Engine Attempts:
    match /attempts/{attemptId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'preparing') || isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.userId == request.auth.uid
        && resource.data.status != 'completed'
        && (
          !('endsAt' in resource.data)
          || !(resource.data.endsAt is timestamp)
          || request.time <= resource.data.endsAt + duration.value(5, 's')
        )
      );
      allow delete: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /organizerApplications/{appId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /organizers/{orgId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // Boardly Study Crews (Squads / Circles)
    match /crews/{crewId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.leaderId == request.auth.uid) || isAdmin();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.leaderId == request.auth.uid);
    }

    // Captains / Ambassadors collection:
    match /captains/{captainId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && (captainId == request.auth.uid || request.resource.data.userId == request.auth.uid));
      allow update: if isAdmin() || (isAuthenticated() && (captainId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /referrals/{refId} {
      allow read: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid ||
        resource.data.ambassadorUid == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referredUid == request.auth.uid ||
        refId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.referredUserId == request.auth.uid ||
        request.resource.data.referredUid == request.auth.uid ||
        refId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.captainId == request.auth.uid ||
        resource.data.ambassadorUid == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referredUid == request.auth.uid ||
        refId == request.auth.uid
      ));
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Content: questions, sheets, universities, formulas
    match /questions/{qId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sheets/{sheetId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /universities/{univId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meritFormulas/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Immutable Audit Logs: read-only by admin, create by authenticated users or admin, no delete/update
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if false;
    }
  }
}
