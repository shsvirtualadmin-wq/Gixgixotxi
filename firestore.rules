rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE AUTHENTICATION & ROLE HELPER FUNCTIONS
    // =========================================================================

    // Checks if the request is from an authenticated user with a valid UID
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks if the authenticated user is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the authenticated user has administrator privileges
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'shsvirtualadmin@gmail.com' ||
          request.auth.token.email.lower() == 'support@boardly.cfd' ||
          request.auth.token.email.lower() == 'support@scholario.me'
        )) ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2'
      );
    }

    // =========================================================================
    // 2. DATA VALIDATION HELPER FUNCTIONS
    // =========================================================================

    // Validates a string is non-null and within specified length boundaries
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validates an optional string field
    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // Validates data URL image length (max 900 KB) and supported mime prefixes
    function isValidDataUrl(val) {
      return val == null || (
        val is string &&
        val.size() <= 921600 && (
          val.matches('^data:image/jpeg;base64,.*') ||
          val.matches('^data:image/png;base64,.*') ||
          val.matches('^data:image/webp;base64,.*') ||
          val.matches('^https://.*')
        )
      );
    }

    // =========================================================================
    // 3. STORE CATALOG ITEMS (STOREITEMS & STORE_ITEMS)
    // =========================================================================

    // Public read for store item catalog, admin write only
    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alternate collection name for catalog store items
    match /store_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store price audit history for administrative tracking
    match /storePriceHistory/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. USER ACCOUNTS & PROFILES (USERS/{USERID})
    // =========================================================================

    match /users/{userId} {
      // Any signed-in user can read profiles for leaderboards, search, and follower interactions
      allow read: if isSignedIn();
      allow list: if isAdmin();

      // Account creation on signup
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin()) &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || isAdmin()) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active' || isAdmin()) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false || isAdmin()) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false || isAdmin());

      // User document update rules:
      // 1. Admin can update anything.
      // 2. Owner can update profile preferences.
      // 3. Owner can update followingCount by exactly +1 or -1 when following/unfollowing.
      // 4. Follower peer can update target user's followersCount by exactly +1 or -1 when following/unfollowing.
      // 5. Owner can update ONLY their own kobans (and kobanBalance) field DOWN for client-side item unlock.
      allow update: if isAdmin() || (
        // Case A: Owner editing preferences
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'name', 'bio', 'status', 'accent', 'targetUniversity',
          'targetTestDate', 'selectedSubjects', 'updatedAt', 'onboardingCompleted',
          'profileCompleted', 'streakFreezeActive', 'equipped', 'avatarKey',
          'avatarVariant', 'photoURL', 'shortId', 'studentId', 'role'
        ])
      ) || (
        // Case B: Owner updating followingCount by exactly +1 or -1
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount', 'updatedAt']) &&
        (
          (!('followingCount' in resource.data) && request.resource.data.followingCount == 1) ||
          request.resource.data.followingCount == resource.data.followingCount + 1 ||
          request.resource.data.followingCount == resource.data.followingCount - 1
        )
      ) || (
        // Case C: Follower peer updating target's followersCount by exactly +1 or -1
        isSignedIn() && request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'updatedAt']) &&
        (
          (!('followersCount' in resource.data) && request.resource.data.followersCount == 1) ||
          request.resource.data.followersCount == resource.data.followersCount + 1 ||
          request.resource.data.followersCount == resource.data.followersCount - 1
        )
      ) || (
        // Case D: Client-side Store Unlock - user may update ONLY kobans (and kobanBalance/updatedAt) DOWN
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kobans', 'kobanBalance', 'updatedAt']) &&
        (
          (!('kobans' in resource.data) || request.resource.data.kobans < resource.data.kobans) &&
          (!('kobanBalance' in resource.data) || request.resource.data.kobanBalance <= resource.data.kobanBalance)
        )
      );

      allow delete: if isAdmin();

      // Subcollection: following (users/{me}/following/{target})
      // A signed-in user can create/delete only where userId == request.auth.uid
      match /following/{targetId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcollection: followers (users/{target}/followers/{me})
      // A signed-in user can create/delete only where followerId == request.auth.uid
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(followerId);
        allow update: if false;
      }

      // Subcollection: unlocked cosmetic items (users/{uid}/unlocked/{itemId})
      // Safe client unlock: user creates unlocked doc if not already existing
      match /unlocked/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          !exists(/databases/$(database)/documents/users/$(userId)/unlocked/$(itemId));
        allow update, delete: if isAdmin();
      }

      // Subcollection: Daily MCQ and AI query quota tracking
      match /usage/{dateKey} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Chapter-level diagnostic performance metrics
      match /chapterStats/{chapterId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Saved study materials
      match /savedCommons/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 5. PUBLIC PROFILES PROJECTION (PUBLICPROFILES/{USERID})
    // =========================================================================

    match /publicProfiles/{userId} {
      allow read: if true;

      allow create: if isOwner(userId) || isAdmin();

      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'status', 'accent', 'avatar', 'frame',
          'nameplate', 'banner', 'effectId', 'equipped', 'badges',
          'crewName', 'updatedAt', 'stats', 'publicStats', 'lastActiveAt',
          'followersCount', 'followingCount', 'rankTitle', 'pinnedBadges',
          'pinnedStamps', 'shortId', 'studentId', 'role'
        ])
      ) || (
        // Allow peer follower/unfollower to update public follower count
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
      );

      allow delete: if isAdmin();

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(followerUid) || isAdmin();
      }
    }

    // =========================================================================
    // 6. WALLETS, COSMETICS & STORE LEDGER
    // =========================================================================

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Ledger history for purchases and grants
      match /ledger/{ledgerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /kobanRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.targetUserId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /nameRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        isValidString(request.resource.data.requestedName, 1, 50) &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. USER PROFILE POSTS (POSTS/{POSTID})
    // =========================================================================

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        (request.resource.data.user_id == request.auth.uid || request.resource.data.uid == request.auth.uid) &&
        isValidString(request.resource.data.text, 0, 5000) &&
        isValidDataUrl(request.resource.data.image_url);

      allow update: if isAdmin() || (
        isSignedIn() && (
          // Author editing content
          (
            (resource.data.user_id == request.auth.uid || resource.data.uid == request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'image_url', 'updated_at', 'updatedAt']) &&
            isValidString(request.resource.data.text, 0, 5000) &&
            isValidDataUrl(request.resource.data.image_url)
          ) ||
          // Any signed in user toggling a like on the post (supports liked_by, likedBy, likes_count, likesCount)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked_by', 'likedBy', 'likes_count', 'likesCount', 'updated_at', 'updatedAt'])
          ) ||
          // Comments count update
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments_count', 'commentCount', 'updated_at', 'updatedAt'])
          )
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.uid == request.auth.uid)
      );

      // Subcollection: likes (posts/{postId}/likes/{userId})
      // Any signed in user can read all likes, create or delete only where userId == request.auth.uid
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcollection: comments (posts/{postId}/comments/{commentId})
      // Any signed in user can read comments, create if request.resource.data.uid == request.auth.uid and text <= 1000 chars.
      // Authors and admins can delete their own comments. No client edits to like counts or other users' fields.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          (request.resource.data.uid == request.auth.uid || request.resource.data.user_id == request.auth.uid || request.resource.data.authorUid == request.auth.uid) &&
          isValidString(request.resource.data.text, 1, 1000);
        allow update: if false;
        allow delete: if isAdmin() || (
          isSignedIn() && (
            resource.data.uid == request.auth.uid ||
            resource.data.user_id == request.auth.uid ||
            resource.data.authorUid == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid
          )
        );
      }
    }

    // =========================================================================
    // 8. BOARDLY COMMONS (COMMONSPOSTS/{POSTID})
    // =========================================================================

    match /commonsPosts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (request.resource.data.isAnonymous == true) ||
        (request.resource.data.authorUid == request.auth.uid)
      );

      allow update: if isAdmin() || (
        isSignedIn() && (
          // Author editing post
          resource.data.authorUid == request.auth.uid ||
          // Upvoting / unvoting, commenting, saving, or reporting
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotes', 'commentCount', 'commentsCount', 'saveCount', 'reportCount', 'isHidden', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // Subcollection: votes (commonsPosts/{postId}/votes/{userId})
      match /votes/{userId} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcollection: comments (commonsPosts/{postId}/comments/{commentId})
      // Any user can read comments; signed in user can create only if request.resource.data.uid == request.auth.uid and text is 1-1000 chars.
      // Authors and admins can delete. No client updates.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          (request.resource.data.uid == request.auth.uid || request.resource.data.authorUid == request.auth.uid) &&
          isValidString(request.resource.data.text, 1, 1000);
        allow update: if false;
        allow delete: if isAdmin() || (
          isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.authorUid == request.auth.uid)
        );
      }
    }

    match /postsPrivate/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /postPrivate/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /commonsReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. STUDY SQUADS & CREWS
    // =========================================================================

    match /crews/{crewId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.memberUids.hasOnly([request.auth.uid]) &&
        request.resource.data.tier == 'free' &&
        request.resource.data.maxMembers <= 5;

      allow update: if isAdmin() || (
        isSignedIn() && (
          (
            resource.data.leaderId == request.auth.uid &&
            request.resource.data.leaderId == resource.data.leaderId &&
            request.resource.data.tier == resource.data.tier &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'bio', 'avatarKey', 'avatarVariant', 'joinMode', 'minStreak',
              'isClosed', 'updatedAt', 'currentQuestions', 'score', 'streak'
            ])
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'memberUids', 'requests', 'updatedAt'
            ]) &&
            request.resource.data.memberUids.size() <= resource.data.maxMembers
          )
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.leaderId == request.auth.uid);
    }

    match /crewApplications/{appId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /crewActivity/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. TEST PAPERS, EXAMS & ACADEMIC RECORDS
    // =========================================================================

    match /pastPapers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /testResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. PROMO CODES & MARKETING
    // =========================================================================

    match /promoCodes/{codeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 12. ACADEMIC QUESTION BANK (QUESTIONS)
    // =========================================================================

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 13. CAMPUS AMBASSADOR & CONTACT INQUIRIES
    // =========================================================================

    match /captainApplications/{appId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /contactInquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
