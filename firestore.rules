rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE AUTH & ROLE HELPERS (Never trust client-passed role fields)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'jJfb1nThG1X9phL8fFDZ0G0J7m33' ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2' ||
        (
          request.auth.token.email == 'shsvirtualadmin@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.role == 'Super Admin'
      );
    }

    // Trusted admin check: custom claims, verified superadmin identity, or /admins/{uid} doc.
    // Never trusts self-editable /users/{uid}.role unless backed by token claim or /admins collection.
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.moderator == true ||
        request.auth.token.role == 'moderator' ||
        request.auth.token.role == 'Moderator' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in ['moderator', 'Moderator', 'admin', 'superadmin', 'Super Admin']
        )
      );
    }

    function isCaptainOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role in ['captain', 'Captain', 'Arena Host'] ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in ['captain', 'Captain', 'Arena Host', 'admin', 'superadmin', 'Super Admin'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isCaptain', false) == true
          )
        )
      );
    }

    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 &&
        email.size() <= 320 &&
        email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isReservedOfficialName(name) {
      return name is string &&
        name.lower().matches('.*(boardly|super\\s*admin|official|moderator|system|staff|support).*');
    }

    function isValidCommonsPostType(t) {
      return t in [
        'question',
        'doubt',
        'notes',
        'resource',
        'past_paper',
        'paper',
        'quiz',
        'mcq',
        'advice',
        'tip',
        'experience',
        'discussion',
        'general',
        'attachment_chunk'
      ];
    }

    // Validates both standard Commons posts and Tier-3 Firestore attachment chunks
    function isValidCommonsPostCreate() {
      return request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 950000 &&
        isValidCommonsPostType(request.resource.data.get('type', 'general')) &&
        request.resource.data.isAnonymous is bool &&
        (
          (
            request.resource.data.isAnonymous == true &&
            request.resource.data.get('authorUid', null) == null
          ) ||
          (
            request.resource.data.isAnonymous == false &&
            request.resource.data.authorUid == request.auth.uid &&
            (
              !isReservedOfficialName(request.resource.data.get('authorName', '')) ||
              isAdmin()
            )
          )
        ) &&
        (
          !('tags' in request.resource.data) ||
          (request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ) &&
        (
          !('files' in request.resource.data) ||
          (request.resource.data.files is list && request.resource.data.files.size() <= 5)
        ) &&
        request.resource.data.get('upvotes', 0) == 0 &&
        request.resource.data.get('downvotes', 0) == 0 &&
        request.resource.data.get('views', 0) == 0 &&
        request.resource.data.get('commentCount', 0) == 0 &&
        request.resource.data.get('reportCount', 0) == 0 &&
        request.resource.data.get('isHidden', false) == false &&
        (
          request.resource.data.get('isPinned', false) == false ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('isFeatured', false) == false ||
          isAdmin()
        );
    }

    // Allows post owners (verified directly or via postsPrivate/{postId}) to update content fields without tampering with counters or moderation flags
    function isCommonsPostOwnerEditableUpdate(postId) {
      return isSignedIn() &&
        (
          (resource.data.isAnonymous == false && resource.data.authorUid == request.auth.uid) ||
          (
            exists(/databases/$(database)/documents/postsPrivate/$(postId)) &&
            get(/databases/$(database)/documents/postsPrivate/$(postId)).data.authorUid == request.auth.uid
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'subject',
          'chapter',
          'target',
          'tags',
          'files',
          'type',
          'board',
          'classLevel',
          'targetExam',
          'difficulty',
          'searchKeywords',
          'isAnonymous',
          'authorUid',
          'authorName',
          'authorAvatar',
          'authorFrame',
          'authorEquippedAvatar',
          'authorPhotoURL',
          'authorRole',
          'authorCustomRole',
          'updatedAt'
        ]) &&
        (
          (
            request.resource.data.isAnonymous == true &&
            request.resource.data.get('authorUid', null) == null
          ) ||
          (
            request.resource.data.isAnonymous == false &&
            request.resource.data.authorUid == request.auth.uid &&
            (
              !isReservedOfficialName(request.resource.data.get('authorName', '')) ||
              isAdmin()
            )
          )
        ) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 20000 &&
        (
          !('tags' in request.resource.data) ||
          (request.resource.data.tags is list && request.resource.data.tags.size() <= 10)
        ) &&
        (
          !('files' in request.resource.data) ||
          (request.resource.data.files is list && request.resource.data.files.size() <= 5)
        );
    }

    // Allows signed-in users to increment/decrement engagement counters by +/- 1 only
    function isCommonsPostCounterUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() &&
        changed.hasOnly([
          'upvotes',
          'downvotes',
          'views',
          'commentCount',
          'commentsCount',
          'savesCount',
          'saveCount',
          'reportCount',
          'isHidden',
          'updatedAt'
        ]) &&
        (
          !changed.hasAny(['upvotes']) ||
          (
            request.resource.data.upvotes is int &&
            request.resource.data.upvotes >= 0 &&
            request.resource.data.upvotes - resource.data.get('upvotes', 0) >= -1 &&
            request.resource.data.upvotes - resource.data.get('upvotes', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['downvotes']) ||
          (
            request.resource.data.downvotes is int &&
            request.resource.data.downvotes >= 0 &&
            request.resource.data.downvotes - resource.data.get('downvotes', 0) >= -1 &&
            request.resource.data.downvotes - resource.data.get('downvotes', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['commentCount']) ||
          (
            request.resource.data.commentCount is int &&
            request.resource.data.commentCount >= 0 &&
            request.resource.data.commentCount - resource.data.get('commentCount', 0) >= -1 &&
            request.resource.data.commentCount - resource.data.get('commentCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['commentsCount']) ||
          (
            request.resource.data.commentsCount is int &&
            request.resource.data.commentsCount >= 0 &&
            request.resource.data.commentsCount - resource.data.get('commentsCount', 0) >= -1 &&
            request.resource.data.commentsCount - resource.data.get('commentsCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['views']) ||
          (
            request.resource.data.views is int &&
            request.resource.data.views >= resource.data.get('views', 0) &&
            request.resource.data.views - resource.data.get('views', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['savesCount']) ||
          (
            request.resource.data.savesCount is int &&
            request.resource.data.savesCount >= 0 &&
            request.resource.data.savesCount - resource.data.get('savesCount', 0) >= -1 &&
            request.resource.data.savesCount - resource.data.get('savesCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['saveCount']) ||
          (
            request.resource.data.saveCount is int &&
            request.resource.data.saveCount >= 0 &&
            request.resource.data.saveCount - resource.data.get('saveCount', 0) >= -1 &&
            request.resource.data.saveCount - resource.data.get('saveCount', 0) <= 1
          )
        ) &&
        (
          !changed.hasAny(['reportCount']) ||
          (
            request.resource.data.reportCount is int &&
            request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
          )
        ) &&
        (
          !changed.hasAny(['isHidden']) ||
          isAdmin() ||
          isModerator() ||
          (
            request.resource.data.isHidden == true &&
            request.resource.data.get('reportCount', 0) >= 3
          )
        );
    }

    // =========================================================================
    // 2. ADMINS COLLECTION
    // =========================================================================

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. USERS & PRIVATE SUBCOLLECTIONS
    // =========================================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if (
        isOwner(userId) &&
        request.resource.data.get('uid', userId) == userId &&
        (!('email' in request.resource.data) || request.resource.data.email == null || isValidEmail(request.resource.data.email)) &&
        request.resource.data.get('role', 'student') in ['student', 'Student'] &&
        request.resource.data.get('plan', 'free') == 'free' &&
        request.resource.data.get('tier', 'free') == 'free' &&
        request.resource.data.get('paid_until', null) == null &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isBanned', false) == false &&
        request.resource.data.get('isSuspended', false) == false &&
        request.resource.data.get('suspended', false) == false &&
        request.resource.data.get('status', 'active') == 'active' &&
        (
          !isReservedOfficialName(request.resource.data.get('displayName', '')) ||
          isAdmin()
        )
      ) || isAdmin();

      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'role',
          'plan',
          'tier',
          'paid_until',
          'subscriptionStatus',
          'isVerified',
          'verified',
          'isBanned',
          'isSuspended',
          'suspended',
          'status',
          'kobanBalance',
          'coins',
          'xp',
          'isCaptain',
          'captainCode',
          'permissions'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
          !isReservedOfficialName(request.resource.data.get('displayName', ''))
        )
      );

      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /unlocked/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /usage/{dateKey} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /activity/{dateKey} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /chapterStats/{chapterId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedCommons/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /readAnnouncements/{announcementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
      }

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 4. PUBLIC PROFILES, USERNAMES & SOCIAL GRAPH
    // =========================================================================

    match /publicProfiles/{userId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('uid', userId) == userId &&
        request.resource.data.get('role', 'student') in ['student', 'Student'] &&
        request.resource.data.get('isVerified', false) == false &&
        !isReservedOfficialName(request.resource.data.get('displayName', ''))
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'role',
          'isVerified',
          'verified',
          'badges',
          'isCaptain'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
          !isReservedOfficialName(request.resource.data.get('displayName', ''))
        )
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'updatedAt'])
      );

      allow delete: if isOwner(userId) || isAdmin();

      match /followers/{followerUid} {
        allow read: if true;
        allow create, update: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == followerUid || isOwner(userId) || isAdmin());
      }

      match /following/{targetUid} {
        allow read: if true;
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId is string &&
        request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && (
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        !isReservedOfficialName(usernameLower);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );
    }

    match /nameRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        !isReservedOfficialName(request.resource.data.get('requestedName', ''));
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. WALLETS, KOBAN ECONOMY & STORE
    // =========================================================================

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('balance', 0) == 0
      );
      allow update, delete: if isAdmin();

      match /ledger/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /kobanTransactions/{txId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /kobanRequests/{reqId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /store_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storePriceHistory/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. PRACTICE ENGINE, QUESTIONS, TESTS & STREAKS
    // =========================================================================

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('creatorId', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /testResults/{resultId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /streaks/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn() && (
        resource.data.get('status', 'published') == 'published' ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /questions_mathematics/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_physics/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_chemistry/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_biology/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_english/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_computer/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_intelligence/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions_general/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questionKeys/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /question_index/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questionReports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('reporterUid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin() || isModerator();
    }

    // =========================================================================
    // 7. AMBASSADOR / CAPTAIN / GRAND LINE SYSTEM
    // =========================================================================

    match /ambassador_tests/{testId} {
      allow read: if true;
      allow create: if isCaptainOrAdmin() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin() || (
        isCaptainOrAdmin() && resource.data.creatorId == request.auth.uid
      ) || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptsCount', 'participantCount', 'updatedAt'])
      );
      allow delete: if isAdmin() || (
        isCaptainOrAdmin() && resource.data.creatorId == request.auth.uid
      );
    }

    match /ambassador_test_attempts/{attemptId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.get('studentUid', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid ||
        isCaptainOrAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('studentUid', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /grand_line_leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /captainApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /captains/{captainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('referredUid', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid ||
          resource.data.get('referrerId', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('referredUid', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. BOARDLY COMMONS (POSTS, VOTES, COMMENTS, REPORTS, ANONYMOUS OWNERSHIP)
    // =========================================================================

    match /commonsPosts/{postId} {
      allow get: if resource == null ||
        resource.data.get('isHidden', false) == false ||
        (isSignedIn() && resource.data.get('authorUid', '') == request.auth.uid) ||
        isAdmin() ||
        isModerator();

      allow list: if isSignedIn() ||
        resource == null ||
        resource.data.get('isHidden', false) == false ||
        isAdmin() ||
        isModerator();

      allow create: if isSignedIn() && isValidCommonsPostCreate();

      allow update: if isAdmin() ||
        isModerator() ||
        isCommonsPostOwnerEditableUpdate(postId) ||
        isCommonsPostCounterUpdate();

      allow delete: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          (
            (resource.data.isAnonymous == false && resource.data.authorUid == request.auth.uid) ||
            (
              exists(/databases/$(database)/documents/postsPrivate/$(postId)) &&
              get(/databases/$(database)/documents/postsPrivate/$(postId)).data.authorUid == request.auth.uid
            )
          )
        );

      match /votes/{voterId} {
        allow read: if true;
        allow create, update: if isOwner(voterId) &&
          request.resource.data.get('uid', voterId) == voterId &&
          request.resource.data.get('value', 1) in [-1, 1];
        allow delete: if isOwner(voterId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() &&
          (
            (
              request.resource.data.get('text', '') is string &&
              request.resource.data.get('text', '').size() >= 1 &&
              request.resource.data.get('text', '').size() <= 3000
            ) ||
            (
              request.resource.data.get('body', '') is string &&
              request.resource.data.get('body', '').size() >= 1 &&
              request.resource.data.get('body', '').size() <= 3000
            )
          ) &&
          request.resource.data.get('isAnonymous', false) is bool &&
          (
            (
              request.resource.data.get('isAnonymous', false) == true &&
              request.resource.data.get('authorUid', null) == null
            ) ||
            (
              request.resource.data.get('isAnonymous', false) == false &&
              request.resource.data.authorUid == request.auth.uid
            )
          );

        allow update: if isAdmin() ||
          isModerator() ||
          (
            isSignedIn() &&
            resource.data.get('isAnonymous', false) == false &&
            resource.data.authorUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'body', 'updatedAt'])
          );

        allow delete: if isAdmin() ||
          isModerator() ||
          (
            isSignedIn() &&
            (
              (resource.data.get('isAnonymous', false) == false && resource.data.authorUid == request.auth.uid) ||
              (
                exists(/databases/$(database)/documents/postsPrivate/$(commentId)) &&
                get(/databases/$(database)/documents/postsPrivate/$(commentId)).data.authorUid == request.auth.uid
              )
            )
          );
      }
    }

    // Dedicated collection for Firestore chunked file attachments
    match /commonsAttachments/{chunkId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.fileId is string &&
        request.resource.data.chunkIndex is int &&
        request.resource.data.totalChunks is int &&
        request.resource.data.data is string &&
        request.resource.data.data.size() <= 950000;
      allow update: if false;
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Private author mapping for anonymous posts, comments, and chunks
    // Strict privacy guarantee: never readable by other students or guests
    match /postsPrivate/{docId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );
      allow list: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.authorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == request.auth.uid
        );
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /postPrivate/{docId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        isModerator()
      );
      allow list: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.authorUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /commonsReports/{reportId} {
      allow read: if isAdmin() || isModerator();
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 2 &&
        request.resource.data.reason.size() <= 1000 &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin() || isModerator();
    }

    // =========================================================================
    // 9. USER FEED POSTS (/posts)
    // =========================================================================

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (
          request.resource.data.get('authorUid', '') == request.auth.uid &&
          request.resource.data.get('content', '') is string &&
          request.resource.data.get('content', '').size() <= 5000 &&
          request.resource.data.get('likesCount', 0) == 0 &&
          request.resource.data.get('commentsCount', 0) == 0
        ) ||
        (
          // Support legacy/fallback attachment chunk documents if ever written to /posts
          request.resource.data.get('authorUid', '') == request.auth.uid &&
          request.resource.data.get('fileId', '') is string &&
          request.resource.data.get('data', '') is string &&
          request.resource.data.get('data', '').size() <= 950000
        )
      );

      allow update: if isAdmin() ||
        isModerator() ||
        (
          isSignedIn() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content',
            'subjectTag',
            'attachmentUrl',
            'attachmentType',
            'attachmentName',
            'updatedAt'
          ])
        ) ||
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt'])
        );

      allow delete: if isAdmin() ||
        isModerator() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);

      match /likes/{likeId} {
        allow read: if true;
        allow create, update: if isOwner(likeId);
        allow delete: if isOwner(likeId) || isAdmin();
      }
    }

    // =========================================================================
    // 10. STUDY BUDDY & NOTIFICATIONS
    // =========================================================================

    match /study_buddy_presence/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /study_buddy_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.get('uid', '') == request.auth.uid;
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.get('uid', '') == request.auth.uid
      );
    }

    match /study_buddy_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.get('senderUid', '') == request.auth.uid &&
        request.resource.data.get('text', '') is string &&
        request.resource.data.get('text', '').size() >= 1 &&
        request.resource.data.get('text', '').size() <= 1000;
      allow update: if false;
      allow delete: if isAdmin() || isModerator() || (
        isSignedIn() && resource.data.get('senderUid', '') == request.auth.uid
      );
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('recipientUid', '') == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead', 'readAt'])
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('recipientUid', '') == request.auth.uid
        )
      );
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. PAYMENTS, CREWS, ARENA, PROMOS, REVIEWS, SUPPORT & AUDIT LOGS
    // =========================================================================

    match /paymentRequests/{requestId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /crews/{crewId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        (
          request.resource.data.get('leaderId', '') == request.auth.uid ||
          request.resource.data.get('captainUid', '') == request.auth.uid ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('tier', 'free') == 'free' ||
          isAdmin()
        ) &&
        (
          request.resource.data.get('paid_until', null) == null ||
          isAdmin()
        );

      allow update: if isAdmin() || (
        // Crew Leader can update crew settings and membership, but cannot self-upgrade tier or exceed free maxMembers (5)
        isSignedIn() &&
        (
          resource.data.get('leaderId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'tier',
          'paid_until',
          'leaderId',
          'isVerified'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxMembers']) ||
          (
            resource.data.get('tier', 'free') == 'paid' &&
            request.resource.data.maxMembers is int &&
            request.resource.data.maxMembers >= 1 &&
            request.resource.data.maxMembers <= 50
          ) ||
          (
            resource.data.get('tier', 'free') != 'paid' &&
            request.resource.data.maxMembers is int &&
            request.resource.data.maxMembers >= 1 &&
            request.resource.data.maxMembers <= 5
          )
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('leaderId', '') == request.auth.uid ||
          resource.data.get('captainUid', '') == request.auth.uid
        )
      );
    }

    match /crew_requests/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('leaderId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /crewApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        ) &&
        request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isAdmin();
    }

    match /programApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /applications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /arenaRegistrations/{regId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /arenaLeaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.get('status', 'approved') == 'approved' ||
        (isSignedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('rating', 5) is int &&
        request.resource.data.get('rating', 5) >= 1 &&
        request.resource.data.get('rating', 5) <= 5;
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.get('userId', '') == request.auth.uid
      );
    }

    match /contactMessages/{msgId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() >= 2 &&
        request.resource.data.get('message', '').size() <= 5000;
      allow update, delete: if isAdmin();
    }

    match /contact_inquiries/{msgId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() >= 2 &&
        request.resource.data.get('message', '').size() <= 5000;
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 12. CATALOG, SESSIONS, MISSIONS, REWARDS & CERTIFICATES
    // =========================================================================

    match /sheets/{sheetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /universities/{uniId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meritFormulas/{formulaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessionResults/{resultId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /crewEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /crewEventAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizers/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizerApplications/{appId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 13. EXPLICIT DEFAULT DENY CATCH-ALL
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
