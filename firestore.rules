rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CORE AUTHENTICATION & ROLE HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Custom Claim-based Admin (never trust client claims or email directly)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin'
      );
    }

    // =========================================================================
    // 2. DATA VALIDATION HELPER FUNCTIONS
    // =========================================================================

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // Image Data URL validator: max 900 KB length, must begin with supported image header
    function isValidDataUrl(val) {
      return val == null || (
        val is string &&
        val.size() <= 921600 && (
          val.matches('^data:image/jpeg;base64,.*') ||
          val.matches('^data:image/png;base64,.*') ||
          val.matches('^data:image/webp;base64,.*') ||
          val.matches('^https://.*')
        )
      );
    }

    function isServerTimestamp(field) {
      return field == request.time;
    }

    // Verify user owns an item before equipping (reads wallets/{uid})
    function userOwnsItem(userId, itemId) {
      return itemId == null || itemId == 'none' || itemId == '' || (
        exists(/databases/$(database)/documents/wallets/$(userId)) &&
        itemId in get(/databases/$(database)/documents/wallets/$(userId)).data.owned
      );
    }

    // =========================================================================
    // 3. USER ACCOUNTS & PROFILES
    // =========================================================================

    // Private Student Document: Personal and security-critical data
    // Contains role, subscription, status, and sensitive info.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Creation on signup: only allowed with default starter fields
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false);

      // Student updates: can only modify non-privileged preference fields
      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Privilege & billing fields are strictly immutable to client
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'status', 'accent', 'targetUniversity',
          'targetTestDate', 'selectedSubjects', 'updatedAt', 'onboardingCompleted',
          'streakFreezeActive'
        ])
      );

      allow delete: if isAdmin();

      // Subcollection: Daily MCQ and AI query quota tracking
      match /usage/{dateKey} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Chapter-level diagnostic performance metrics
      match /chapterStats/{chapterId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Subcollection: Saved study materials
      match /savedCommons/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Public Profiles: Viewable by all signed-in users for leaderboards, search, squads
    match /publicProfiles/{userId} {
      allow read: if isSignedIn() || isAdmin();

      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId;

      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent client from escalating public stats directly
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'status', 'accent', 'avatar', 'frame',
          'nameplate', 'banner', 'effectId', 'equipped', 'badges',
          'crewName', 'updatedAt', 'followersCount', 'followingCount'
        ]) &&
        // Equipping verification: user must own the equipped cosmetic
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatar', 'frame', 'nameplate', 'banner', 'effectId']) ||
          (
            userOwnsItem(userId, request.resource.data.avatar) &&
            userOwnsItem(userId, request.resource.data.frame) &&
            userOwnsItem(userId, request.resource.data.nameplate) &&
            userOwnsItem(userId, request.resource.data.banner) &&
            userOwnsItem(userId, request.resource.data.effectId)
          )
        )
      );

      allow delete: if isAdmin();

      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 4. WALLETS, COSMETICS & STORE LEDGER
    // =========================================================================

    // Student Wallet: Koban currency balance and owned cosmetic inventory
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Wallet initialization on signup: balance must be 0, cannot grant self items
      allow create: if isOwner(userId) &&
        request.resource.data.balance == 0 &&
        request.resource.data.owned.size() == 0;

      // Updating wallet: Clients can ONLY update equipped slots.
      // Balance and owned items are STRICTLY server/Admin SDK-writable!
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped', 'updatedAt']) &&
        // Verification: Any newly equipped item must already exist in resource.data.owned
        (
          userOwnsItem(userId, request.resource.data.equipped.avatar) &&
          userOwnsItem(userId, request.resource.data.equipped.frame) &&
          userOwnsItem(userId, request.resource.data.equipped.nameplate) &&
          userOwnsItem(userId, request.resource.data.equipped.banner) &&
          userOwnsItem(userId, request.resource.data.equipped.effect)
        )
      );

      allow delete: if isAdmin();

      // Ledger history: Append-only transaction log. Read-only for student.
      match /ledger/{ledgerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin(); // Client cannot tamper with purchase or grant records
      }
    }

    // Store Catalog Items: Published cosmetic cards and prices
    match /store_items/{itemId} {
      allow read: if true; // Public pricing catalog
      allow write: if isAdmin();
    }

    match /storePriceHistory/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Koban grant requests (Captain rewards or promotional redemptions)
    match /kobanRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.targetUserId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. USER POSTS FEED (PROFILE POSTS)
    // =========================================================================

    match /posts/{postId} {
      // Anyone signed in can read the feed
      allow read: if isSignedIn();

      // Create post: Must be author, text/image length validation
      allow create: if isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        isValidString(request.resource.data.text, 0, 5000) &&
        (request.resource.data.text.size() > 0 || request.resource.data.image_url != null) &&
        isValidDataUrl(request.resource.data.image_url) &&
        request.resource.data.likes_count == 0 &&
        request.resource.data.liked_by.size() == 0;

      // Update post:
      // Case A: Author editing content (text or image)
      // Case B: Any authenticated peer toggling a Like (strictly validated)
      allow update: if isAdmin() || (
        isSignedIn() && (
          // Author editing text or image
          (
            resource.data.user_id == request.auth.uid &&
            request.resource.data.user_id == resource.data.user_id &&
            request.resource.data.created_at == resource.data.created_at &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'image_url', 'updated_at']) &&
            isValidString(request.resource.data.text, 0, 5000) &&
            isValidDataUrl(request.resource.data.image_url)
          ) ||
          // Atomic like toggle verification: only liked_by and likes_count can change
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked_by', 'likes_count']) &&
            (
              // Liking: Adding self to liked_by, incrementing likes_count by 1
              (
                !(request.auth.uid in resource.data.liked_by) &&
                (request.auth.uid in request.resource.data.liked_by) &&
                request.resource.data.liked_by.size() == resource.data.liked_by.size() + 1 &&
                request.resource.data.likes_count == resource.data.likes_count + 1 &&
                request.resource.data.likes_count == request.resource.data.liked_by.size()
              ) ||
              // Unliking: Removing self from liked_by, decrementing likes_count by 1
              (
                (request.auth.uid in resource.data.liked_by) &&
                !(request.auth.uid in request.resource.data.liked_by) &&
                request.resource.data.liked_by.size() == resource.data.liked_by.size() - 1 &&
                request.resource.data.likes_count == resource.data.likes_count - 1 &&
                request.resource.data.likes_count == request.resource.data.liked_by.size()
              )
            )
          )
        )
      );

      // Delete post: Author or Admin only
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.user_id == request.auth.uid
      );

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.user_id == request.auth.uid &&
          isValidString(request.resource.data.text, 1, 1000);
        allow update: if isSignedIn() &&
          resource.data.user_id == request.auth.uid &&
          request.resource.data.user_id == resource.data.user_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updated_at']);
        allow delete: if isAdmin() || (
          isSignedIn() && (
            resource.data.user_id == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid
          )
        );
      }
    }

    // =========================================================================
    // 6. BOARDLY COMMONS (STUDY RESOURCE EXCHANGE)
    // =========================================================================

    match /commonsPosts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && (
        (request.resource.data.isAnonymous == true && request.resource.data.authorUid == null) ||
        (request.resource.data.isAnonymous == false && request.resource.data.authorUid == request.auth.uid)
      );

      allow update: if isAdmin() || (
        isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotes', 'commentCount', 'saveCount', 'reportCount', 'isHidden', 'updatedAt'
          ])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      match /votes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /postsPrivate/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /postPrivate/{postId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /commonsReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. STUDY SQUADS & CREWS
    // =========================================================================

    match /crews/{crewId} {
      // Public crew directory for leaderboard and joining
      allow read: if true;

      // Only authenticated users can form a crew; creator must be the leader
      allow create: if isSignedIn() &&
        request.resource.data.leaderId == request.auth.uid &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.memberUids.hasOnly([request.auth.uid]) &&
        request.resource.data.tier == 'free' &&
        request.resource.data.maxMembers <= 5;

      // Update rules:
      // Leader: can update settings (name, bio, joinMode, minStreak, avatar)
      // Members joining / leaving: atomic memberUid addition/removal
      allow update: if isAdmin() || (
        isSignedIn() && (
          // Leader editing settings
          (
            resource.data.leaderId == request.auth.uid &&
            request.resource.data.leaderId == resource.data.leaderId &&
            request.resource.data.tier == resource.data.tier &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'bio', 'avatarKey', 'avatarVariant', 'joinMode', 'minStreak',
              'isClosed', 'updatedAt', 'currentQuestions', 'score', 'streak'
            ])
          ) ||
          // Member joining or leaving self
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'memberUids', 'requests', 'updatedAt'
            ]) &&
            request.resource.data.memberUids.size() <= resource.data.maxMembers &&
            (
              // Joining: User adds their own UID
              (
                !(request.auth.uid in resource.data.memberUids) &&
                (request.auth.uid in request.resource.data.memberUids) &&
                (!('isClosed' in resource.data) || resource.data.isClosed != true)
              ) ||
              // Leaving: User removes their own UID
              (
                (request.auth.uid in resource.data.memberUids) &&
                !(request.auth.uid in request.resource.data.memberUids)
              )
            )
          )
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.leaderId == request.auth.uid);
    }

    match /crewApplications/{appId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /captainApplications/{appId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /captains/{captainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. SOCIAL EDGES: FOLLOWS
    // =========================================================================

    match /follows/{followId} {
      allow read: if isSignedIn();

      // Create: User can only follow as themselves, document ID must equal {follower}_{target}
      allow create: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followerId != request.resource.data.targetId &&
        followId == (request.auth.uid + '_' + request.resource.data.targetId);

      // Follow edges are immutable once created
      allow update: if false;

      // Delete: Only the follower can unfollow
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.followerId == request.auth.uid
      );
    }

    // =========================================================================
    // 9. MCQ ATTEMPTS & TEST ENGINE
    // =========================================================================

    match /attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.uid) || isAdmin();

      // Student creates attempt with their own uid
      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid) &&
        (request.resource.data.status == 'preparing' || request.resource.data.status == 'in_progress');

      // Update permitted only while test is active (cannot re-open completed test)
      allow update: if isAdmin() || (
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid) &&
        resource.data.status != 'completed'
      );

      // Immutable history: tests cannot be deleted by students
      allow delete: if isAdmin();
    }

    match /streaks/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Computed metric: writes reserved for Admin SDK / Cloud Functions
      allow write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 10. ENTRANCE TEST QUESTION BANK (~17,000 MCQs)
    // =========================================================================

    match /questions/{qId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.status == 'published' && resource.data.active == true
      );
      allow write: if isAdmin();
    }

    match /questions_mathematics/{qId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.status == 'published');
      allow write: if isAdmin();
    }

    match /{poolName}/{docId} {
      allow read: if poolName.matches('questions_.*') && (
        isAdmin() || (isSignedIn() && resource.data.status == 'published')
      );
      allow write: if poolName.matches('questions_.*') && isAdmin();
    }

    match /question_index/{subject} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    match /questionKeys/{keyId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    match /questionReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. REFERRALS, PAYMENTS & AUDIT LOGS
    // =========================================================================

    match /referrals/{refId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.captainId == request.auth.uid ||
          resource.data.ambassadorUid == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid ||
          refId == request.auth.uid
        )
      );
      allow create: if isSignedIn() && (
        request.resource.data.referredUserId == request.auth.uid ||
        refId == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /paymentRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if true; // Public contact form submissions
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Immutable system audit trail: Client writes strictly DENIED
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ambassador_tests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ambassador_test_attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /study_buddy_logs/{logId} {
      allow read: if isOwner(resource.data.student_id) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /study_buddy_presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 12. DEFAULT DENY CATCH-ALL
    // =========================================================================

    // Any document path not explicitly authorized above is strictly denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
