rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE SECURITY HELPERS (FAIL-CLOSED, FIREBASE AUTH CUSTOM CLAIMS ONLY)
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function isSignedIn() {
      return signedIn();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerEmail() {
      return 'shsvirtualadmin@gmail.com';
    }

    // Verified owner email from signed Firebase Auth token (never client-writable fields).
    function isVerifiedOwnerEmail() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == ownerEmail();
    }

    // Roles come from verified Firebase Auth custom claims OR the verified owner email claim
    // in the Firebase Auth ID token. Never from client-writable Firestore fields or unverified emails.
    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.superAdmin == true ||
        isVerifiedOwnerEmail()
      );
    }

    // superAdmin implies admin. Everything else without admin/superAdmin is a normal user.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        isSuperAdmin()
      );
    }

    // Hierarchy: superAdmin > admin > captain > student
    function isCaptain() {
      return signedIn() && (
        request.auth.token.captain == true ||
        isAdmin()
      );
    }

    // Nobody can grant superAdmin from the client
    function clientDoesNotGrantSuperAdmin() {
      return (
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
        (!('role' in request.resource.data) || !(request.resource.data.role in ['super_admin', 'superadmin']))
      );
    }

    // Helper functions for checking paid plan tiers (pro or plus)
    function isPaidPlan(uid) {
      let userData = get(/databases/$(database)/documents/users/$(uid)).data;
      return userData.plan in ['pro', 'plus'] ||
        userData.planTier in ['pro', 'plus'] ||
        userData.isPremium == true ||
        userData.isPro == true ||
        userData.isPlus == true;
    }

    function isPlusPlan(uid) {
      let userData = get(/databases/$(database)/documents/users/$(uid)).data;
      return userData.plan == 'plus' ||
        userData.planTier == 'plus' ||
        userData.isPlus == true;
    }

    // Blocks owner updates to any protected role, admin, superAdmin, captain, claimsUpdatedAt, plan, pro, plus, aiUsage, or wallet fields
    function ownerUpdatesOnlySafeUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'isAdmin',
        'superAdmin',
        'isSuperAdmin',
        'isCaptain',
        'isAmbassador',
        'claimsUpdatedAt',
        'claimsUpdatedAtMs',
        'plan',
        'planTier',
        'planId',
        'pro',
        'isPro',
        'plus',
        'isPlus',
        'tier',
        'kobans',
        'kobanBalance',
        'proUntil',
        'plusUntil',
        'paid_until',
        'planExpiresAt',
        'premiumExpiresAt',
        'isPremium',
        'proPlanId',
        'plusPlanId',
        'premiumSource',
        'aiUsage',
        'aiCreditsUsed',
        'isBanned',
        'isSuspended',
        'suspended',
        'status',
        'permissions'
      ]);
    }

    // Blocks owner from creating a user doc with role, isAdmin, superAdmin, isCaptain, claimsUpdatedAt, plan, pro, plus, or aiUsage
    function ownerCreatesOnlySafeUserFields() {
      return (
        (!('role' in request.resource.data) || request.resource.data.role in ['student', 'user']) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false) &&
        (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false) &&
        (!('isCaptain' in request.resource.data) || request.resource.data.isCaptain == false) &&
        (!('isAmbassador' in request.resource.data) || request.resource.data.isAmbassador == false) &&
        (!('claimsUpdatedAt' in request.resource.data)) &&
        (!('claimsUpdatedAtMs' in request.resource.data)) &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&
        (!('planTier' in request.resource.data) || request.resource.data.planTier == 'free') &&
        (!('planId' in request.resource.data) || request.resource.data.planId == null) &&
        (!('pro' in request.resource.data) || request.resource.data.pro == false) &&
        (!('isPro' in request.resource.data) || request.resource.data.isPro == false) &&
        (!('plus' in request.resource.data) || request.resource.data.plus == false) &&
        (!('isPlus' in request.resource.data) || request.resource.data.isPlus == false) &&
        (!('tier' in request.resource.data) || request.resource.data.tier == 'free') &&
        (!('kobans' in request.resource.data) || request.resource.data.kobans == 0) &&
        (!('kobanBalance' in request.resource.data) || request.resource.data.kobanBalance == 0) &&
        (!('proUntil' in request.resource.data) || request.resource.data.proUntil == null) &&
        (!('plusUntil' in request.resource.data) || request.resource.data.plusUntil == null) &&
        (!('paid_until' in request.resource.data) || request.resource.data.paid_until == null) &&
        (!('planExpiresAt' in request.resource.data) || request.resource.data.planExpiresAt == null) &&
        (!('premiumExpiresAt' in request.resource.data) || request.resource.data.premiumExpiresAt == null) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
        (!('proPlanId' in request.resource.data) || request.resource.data.proPlanId == null) &&
        (!('plusPlanId' in request.resource.data) || request.resource.data.plusPlanId == null) &&
        (!('aiUsage' in request.resource.data)) &&
        (!('aiCreditsUsed' in request.resource.data) || request.resource.data.aiCreditsUsed == 0)
      );
    }

    // Validates that any updated avatar / avatarId / equippedAvatar is either in the free system avatar allowlist or in the user's owned items
    function isFreeSystemAvatar(avatarVal) {
      return avatarVal == null || avatarVal == '' || avatarVal == 'none' || avatarVal in [
        'skull-01', 'skull-02',
        'robot-01', 'robot-02', 'robot-03',
        'animal-01', 'animal-02', 'animal-03',
        'flame-01', 'flame-02',
        'bolt-01', 'bolt-02',
        'star-01', 'star-02',
        'shield-01', 'shield-02',
        'crown-01', 'crown-02',
        'planet-01', 'planet-02',
        'science-01', 'science-02',
        'glyph-01', 'glyph-02', 'glyph-03', 'glyph-04', 'glyph-05', 'glyph-06'
      ];
    }

    function isAllowedUserAvatar(uid, avatarVal) {
      return isFreeSystemAvatar(avatarVal) ||
        (
          exists(/databases/$(database)/documents/wallets/$(uid)) &&
          'owned' in get(/databases/$(database)/documents/wallets/$(uid)).data &&
          avatarVal in get(/databases/$(database)/documents/wallets/$(uid)).data.owned
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          'ownedCosmetics' in get(/databases/$(database)/documents/users/$(uid)).data &&
          avatarVal in get(/databases/$(database)/documents/users/$(uid)).data.ownedCosmetics
        ) ||
        exists(/databases/$(database)/documents/users/$(uid)/unlocked/$(avatarVal));
    }

    function validAvatarFieldsForUser(uid, data) {
      return (!('avatar' in data) || isAllowedUserAvatar(uid, data.avatar)) &&
        (!('avatarId' in data) || isAllowedUserAvatar(uid, data.avatarId)) &&
        (!('equippedAvatar' in data) || isAllowedUserAvatar(uid, data.equippedAvatar)) &&
        (!('equipped' in data) || !(data.equipped is map) || !('avatar' in data.equipped) || isAllowedUserAvatar(uid, data.equipped.avatar));
    }

    // =========================================================================
    // 1. USERS & USER SUBCOLLECTIONS
    //    Users cannot write role, isAdmin, superAdmin, plan, or pro on their own docs.
    //    Nobody can grant superAdmin from the client.
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if clientDoesNotGrantSuperAdmin() && (
        isSuperAdmin() ||
        (isAdmin() && !('role' in request.resource.data)) ||
        (isOwner(userId) && ownerCreatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data))
      );
      allow update: if clientDoesNotGrantSuperAdmin() && (
        isSuperAdmin() ||
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'superAdmin', 'isSuperAdmin'])) ||
        (isOwner(userId) && ownerUpdatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data)) ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();

      // Inventory & Unlocked Cosmetics: owner or admin read, admin write only
      match /inventory/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /unlocked/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // User Notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if signedIn();
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // Followers / Following subcollections
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || isOwner(followerUid) || isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin() || isOwner(userId);
      }

      // User Progress, Attempts, Bookmarks, Settings, Stats, Reward History
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /SavedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /stats/{statId} {
        allow read: if signedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /rewardHistory/{claimId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /dailyClaims/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Boardly AI Mentors — Chat History (Owner-only read/write, never stores raw attachments)
      match /aiChats/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['mentor', 'title', 'updatedAt', 'messages'])
          && request.resource.data.mentor is int
          && request.resource.data.mentor >= 0
          && request.resource.data.mentor <= 4
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 48
          && request.resource.data.messages is list
          && request.resource.data.messages.size() <= 120;
      }

      // Boardly AI Mentors — Server-enforced Daily Credit Counter (Client read-only; server/function writes only)
      match /aiUsage/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // =========================================================================
    // 2. ADMIN COLLECTIONS (Require admin or superAdmin custom claim)
    // =========================================================================
    match /payment_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /paymentRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /kobanRequests/{reqId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.status == 'pending' &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /captainApplications/{appId} {
      allow read: if isAdmin() || isOwner(appId);
      allow create: if signedIn() && (appId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /crewApplications/{appId} {
      allow read: if isAdmin() || isOwner(appId);
      allow create: if signedIn() && (appId == request.auth.uid || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /supportRequests/{reqId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. ROLE, SETTINGS & SYSTEM COLLECTIONS (Require superAdmin custom claim ONLY)
    // =========================================================================
    match /roles/{docId} {
      allow read, write: if isSuperAdmin() && clientDoesNotGrantSuperAdmin();
    }

    match /user_roles/{docId} {
      allow read, write: if isSuperAdmin() && clientDoesNotGrantSuperAdmin();
    }

    match /admins/{docId} {
      allow read, write: if isSuperAdmin() && clientDoesNotGrantSuperAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Plan pricing & AI credit limits (public read so client & pricing pages stay synced; admin-only write)
    match /config/plans {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /system/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 4. COUPON REDEMPTIONS, COUPONS & STORE ITEMS
    // =========================================================================
    match /couponRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        ) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /promoCodes/{codeId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /storeItems/{itemId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /store_items/{itemId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 5. INVENTORY & WALLETS
    // =========================================================================
    match /inventory/{docId} {
      allow read: if isAdmin() || (
        signedIn() && (
          docId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('balance' in request.resource.data) || request.resource.data.balance == 0) &&
        (!('owned' in request.resource.data) || request.resource.data.owned.size() == 0) &&
        validAvatarFieldsForUser(userId, request.resource.data)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped', 'updatedAt']) &&
        validAvatarFieldsForUser(userId, request.resource.data)
      );
      allow delete: if isSuperAdmin();

      match /ledger/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // 6. POSTS (Boardly Commons)
    // =========================================================================
    match /commonsPosts/{postId} {
      allow read: if signedIn() || resource.data.status == 'published';
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount',
            'likedBy',
            'commentsCount',
            'savesCount',
            'savedBy',
            'viewsCount',
            'downloadsCount',
            'sharesCount',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        );
        allow update, delete: if isAdmin() || (
          signedIn() && (
            resource.data.authorId == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            resource.data.uid == request.auth.uid
          )
        );
      }

      match /likes/{likeUid} {
        allow read: if true;
        allow create, update, delete: if isOwner(likeUid) || isAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if signedIn() || resource.data.status == 'published';
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 7. CREWS, CREW MEMBERS & CREW REQUESTS
    // =========================================================================
    match /crews/{crewId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.createdBy == request.auth.uid ||
          request.resource.data.ownerId == request.auth.uid ||
          request.resource.data.captainId == request.auth.uid
        ) &&
        (!('tier' in request.resource.data) || request.resource.data.tier == 'free') &&
        (!('paid_until' in request.resource.data) || request.resource.data.paid_until == null)
      );
      allow update: if isAdmin() || (
        signedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'paid_until']) &&
        (
          resource.data.createdBy == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.captainId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members',
            'memberUids',
            'memberCount',
            'hasProMember',
            'updatedAt',
            'weeklyXp',
            'totalXp',
            'score'
          ])
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          resource.data.createdBy == request.auth.uid ||
          resource.data.ownerId == request.auth.uid ||
          resource.data.captainId == request.auth.uid
        )
      );

      match /{subCol}/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() || isAdmin();
      }
    }

    match /crew_members/{memberId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn() && (
          memberId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          memberId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    match /crew_requests/{requestId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.fromUid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid ||
          resource.data.captainId == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 8. FOLLOWS & NOTIFICATIONS
    // =========================================================================
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.followerId == request.auth.uid ||
          request.resource.data.followerUid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.followerId == request.auth.uid ||
          resource.data.followerUid == request.auth.uid ||
          resource.data.followingId == request.auth.uid ||
          resource.data.followingUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        )
      );
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        )
      );
      allow create: if isAdmin() || (
        signedIn() && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.actorId == request.auth.uid ||
          request.resource.data.authorId == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        )
      );
      allow update, delete: if isAdmin() || (
        signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        )
      );
    }

    // =========================================================================
    // 8B. DIRECT MESSAGES: CONVERSATIONS, MESSAGES & CHAT REQUESTS
    //     Signed-in users can ONLY read/write chats, requests, and messages
    //     where they are an explicit participant. Admin roles remain claim-based only.
    // =========================================================================
    match /conversations/{conversationId} {
      allow get: if isAdmin() || (
        signedIn() && (
          (resource != null && 'participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants) ||
          (resource == null && (
            conversationId.matches('^conv_' + request.auth.uid + '_.*$') ||
            conversationId.matches('^conv_.*_' + request.auth.uid + '$')
          ))
        )
      );
      allow list: if isAdmin() || (
        signedIn() &&
        'participants' in resource.data &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants
      );
      allow create: if isAdmin() || (
        signedIn() &&
        'participants' in request.resource.data &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAdmin() || (
        signedIn() &&
        'participants' in resource.data &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (
          signedIn() && (
            (resource != null && (
              resource.data.senderId == request.auth.uid ||
              resource.data.recipientId == request.auth.uid
            )) ||
            conversationId.matches('^conv_' + request.auth.uid + '_.*$') ||
            conversationId.matches('^conv_.*_' + request.auth.uid + '$') ||
            (
              exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            )
          )
        );
        allow create: if isAdmin() || (
          signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 && (
            conversationId.matches('^conv_' + request.auth.uid + '_.*$') ||
            conversationId.matches('^conv_.*_' + request.auth.uid + '$') ||
            (
              exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            )
          )
        );
        allow update: if isAdmin() || (
          signedIn() &&
          (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
        );
        allow delete: if isSuperAdmin();
      }
    }

    match /chats/{chatId} {
      allow get: if isAdmin() || (
        signedIn() && (
          (resource != null && 'participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants) ||
          (resource == null && (
            chatId.matches('^conv_' + request.auth.uid + '_.*$') ||
            chatId.matches('^conv_.*_' + request.auth.uid + '$')
          ))
        )
      );
      allow list: if isAdmin() || (
        signedIn() &&
        'participants' in resource.data &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants
      );
      allow create: if isAdmin() || (
        signedIn() &&
        'participants' in request.resource.data &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAdmin() || (
        signedIn() &&
        'participants' in resource.data &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (
          signedIn() && (
            (resource != null && (
              resource.data.senderId == request.auth.uid ||
              resource.data.recipientId == request.auth.uid
            )) ||
            chatId.matches('^conv_' + request.auth.uid + '_.*$') ||
            chatId.matches('^conv_.*_' + request.auth.uid + '$') ||
            (
              exists(/databases/$(database)/documents/chats/$(chatId)) &&
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            )
          )
        );
        allow create: if isAdmin() || (
          signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000
        );
        allow update: if isAdmin() || (
          signedIn() &&
          (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
        );
        allow delete: if isSuperAdmin();
      }
    }

    match /chatRequests/{requestId} {
      allow get: if isAdmin() || (
        signedIn() && (
          (resource != null && (
            resource.data.fromUid == request.auth.uid ||
            resource.data.toUid == request.auth.uid ||
            ('participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants)
          )) ||
          (resource == null && (
            requestId.matches('^' + request.auth.uid + '_.*$') ||
            requestId.matches('^.*_' + request.auth.uid + '$')
          ))
        )
      );
      allow list: if isAdmin() || (
        signedIn() && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid ||
          ('participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants)
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid
      );
      allow update: if isAdmin() || (
        signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid
      );
      allow delete: if isAdmin() || (
        signedIn() && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        )
      );
    }

    match /chat_requests/{requestId} {
      allow get, list: if isAdmin() || (
        signedIn() && (
          (resource != null && (
            resource.data.fromUid == request.auth.uid ||
            resource.data.toUid == request.auth.uid ||
            ('participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants)
          )) ||
          (resource == null && (
            requestId.matches('^' + request.auth.uid + '_.*$') ||
            requestId.matches('^.*_' + request.auth.uid + '$')
          ))
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid
      );
      allow update: if isAdmin() || (
        signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. SUPPORTING APPLICATION COLLECTIONS
    // =========================================================================
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if clientDoesNotGrantSuperAdmin() && (
        isSuperAdmin() ||
        (isOwner(userId) && ownerCreatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data))
      );
      allow update: if clientDoesNotGrantSuperAdmin() && (
        isSuperAdmin() ||
        (isOwner(userId) && ownerUpdatesOnlySafeUserFields() && validAvatarFieldsForUser(userId, request.resource.data)) ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();

      match /followers/{followerUid} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isOwner(followerUid) || isOwner(userId);
      }

      match /following/{targetUid} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isOwner(userId);
      }
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        signedIn() && request.resource.data.uid == request.auth.uid
      );
      allow delete: if isAdmin() || (
        signedIn() && resource.data.uid == request.auth.uid
      );
    }

    match /referrals/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if signedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /testAttempts/{attemptId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /user_events/{eventId} {
      allow read: if isAdmin() || (
        signedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /dailySnapshots/{snapshotId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mcqs/{mcqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mcq_banks/{bankId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pastPapers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 10. FINAL CATCH-ALL: FAIL CLOSED
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
