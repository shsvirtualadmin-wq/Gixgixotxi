rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization rule:
    // Only the email shsvirtualadmin@gmail.com with email_verified == true,
    // or a document in the admins collection.
    // No other email addresses and no role-based or token-claim conditions.
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'shsvirtualadmin@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Protect critical fields (plan, role, premium, premiumSource, ambassador/crew, admin)
    // Owners cannot change these fields on their own document; only admins can edit them.
    function userDoesNotChangeProtectedFields() {
      let protectedKeys = [
        'plan',
        'role',
        'roles',
        'isPremium',
        'premium',
        'premiumExpiresAt',
        'premiumSource',
        'previousPlan',
        'isCrewMember',
        'crewStatus',
        'crewStartDate',
        'crewReferralCode',
        'crewRevokedAt',
        'crewRevokeReason',
        'isPaidInternshipEligible',
        'ambassador',
        'admin',
        'isAdmin'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys);
    }

    function userInitialDocHasSafeFields() {
      let data = request.resource.data;
      return (!('role' in data) || data.role == 'student')
        && (!('plan' in data) || data.plan in ['free', 'starter'])
        && (!('isPremium' in data) || data.isPremium == false)
        && (!('premiumSource' in data) || data.premiumSource == null)
        && (!('isCrewMember' in data) || data.isCrewMember == false)
        && (!('admin' in data) || data.admin == false);
    }

    // Users collection:
    // Owners can read and update their own document but cannot change plan, role, premium, premiumSource, ambassador or admin fields.
    // Only admins can change those.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && (isAdmin() || userInitialDocHasSafeFields())) || isAdmin();
      allow update: if (isOwner(userId) && userDoesNotChangeProtectedFields()) || isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // In-App Notifications: Users read and mark read their own notifications; admins create and delete
    match /notifications/{notifId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'approved')
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 800;

      allow update: if (
          isAuthenticated()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
        ) || (
          isAdmin()
          && !(resource.data.uid == request.auth.uid && request.resource.data.status == 'approved')
        );

      allow delete: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // System configurations and Admin access list
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Payment upgrade requests
    match /paymentRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Competitive event sessions (Blitz, Arena, Study Circles)
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.organizerId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.organizerId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Boardly Crew Events:
    // Public read for events. Crew members can only create, update, and delete their own events.
    match /crewEvents/{eventId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.organizerId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.organizerId == request.auth.uid) || isAdmin();
    }

    // Boardly Crew Event Attempts:
    // Public read for leaderboard. Authenticated users submit their own attempt.
    match /crewEventAttempts/{attemptId} {
      allow read: if true;
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /sessionResults/{resultId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Organizer applications & management
    match /organizerApplications/{appId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /organizers/{orgId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    // Campus Captains & Boardly Crew Ambassador Applications:
    // Create denied for admins, one application per user (document id = their uid), only admins can update or delete.
    match /captainApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && !isAdmin() && appId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /crewApplications/{appId} {
      allow read: if (isAuthenticated() && (resource.data.userId == request.auth.uid || appId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && !isAdmin() && (appId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Captains / Ambassadors collection:
    // Authenticated users can read captains so registering students can look up the matching ambassador by referral code.
    // Only admins can write.
    match /captains/{captainId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /referrals/{refId} {
      allow read: if (isAuthenticated() && (
        resource.data.captainId == request.auth.uid ||
        resource.data.ambassadorUid == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid
      )) || isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.referredUserId == request.auth.uid || refId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /missions/{missionId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{redemptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Content: questions, sheets, universities, formulas
    match /questions/{qId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /sheets/{sheetId} {
      allow read: if isAuthenticated() || isAdmin();
      allow write: if isAdmin();
    }

    match /universities/{univId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meritFormulas/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Immutable Audit Logs: read-only by admin, create by admin, no delete/update
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
