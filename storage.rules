rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'jJfb1nThG1X9phL8fFDZ0G0J7m33' ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2' ||
        (
          request.auth.token.email == 'shsvirtualadmin@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'superadmin', 'Super Admin']
      );
    }

    function isValidImageUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidAttachmentUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        (
          request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // 1. User Avatars / Profile Pictures (max 5 MB, images only, owner-only write)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidImageUpload(5 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. User Profile Banners (max 5 MB, images only, owner-only write)
    match /banners/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidImageUpload(5 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Commons Post Attachments (max 15 MB, images or PDFs, owner-only write)
    match /commons/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidAttachmentUpload(15 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 4. Payment Receipts / Verification Screenshots (max 10 MB, owner & admin read, owner create)
    match /payments/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidAttachmentUpload(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // 5. Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
