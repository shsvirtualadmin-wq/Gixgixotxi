rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin' ||
        request.auth.uid == 'A5YMRimdHRcmeDWutxtUGt2e4hf2' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'shsvirtualadmin@gmail.com' ||
          request.auth.token.email.lower() == 'admin@shsvirtual.org' ||
          request.auth.token.email.lower() == 'support@boardly.cfd' ||
          request.auth.token.email.lower() == 'support@scholario.me' ||
          request.auth.token.email.lower() == 'hashir@boardly.pk'
        ))
      );
    }

    function isValidImage(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        (
          request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') ||
          request.resource.contentType == 'image/jpeg' ||
          request.resource.contentType == 'image/jpg' ||
          request.resource.contentType == 'image/png' ||
          request.resource.contentType == 'image/webp' ||
          request.resource.contentType == 'image/gif'
        );
    }

    // -------------------------------------------------------------------------
    // USER PUBLIC ASSETS (Avatar, Profile Banner, Feed Post Media)
    // -------------------------------------------------------------------------
    match /users/{userId} {

      // User Profile Avatars: Publicly viewable, max 2 MB
      match /avatars/{fileName} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidImage(2 * 1024 * 1024);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User Profile Banners: Publicly viewable, max 5 MB
      match /banners/{fileName} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidImage(5 * 1024 * 1024);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User Profile Feed Post Images: Publicly viewable, max 25 MB
      match /posts/{fileName} {
        allow read: if true;
        allow write: if isOwner(userId) && isValidImage(25 * 1024 * 1024);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Private Payment Screenshots / Receipts (if stored in Storage): Owner or Admin ONLY
      match /receipts/{fileName} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && isValidImage(10 * 1024 * 1024);
        allow delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // POSTS ALIAS (/posts/{userId}/{fileName})
    // -------------------------------------------------------------------------
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage(25 * 1024 * 1024);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // COMMONS STUDY MATERIAL UPLOADS (PDFs, notes, study resources up to 25 MB)
    // Public metadata is read from Firestore; downloading the actual file requires login
    // -------------------------------------------------------------------------
    match /commons/{uploaderId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uploaderId) &&
        request.resource.size <= 25 * 1024 * 1024 &&
        !fileName.matches('.*\\.(exe|bat|cmd|sh|bin|msi|apk|jar|scr|vbs|js|com|wsf|ps1)$');
      allow delete: if isOwner(uploaderId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // DEFAULT CATCH-ALL: Strictly deny any unlisted paths
    // -------------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
