{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile, preferences, onboarding choices, and plan metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "plan": { "type": "string", "enum": ["starter", "steady_climb", "all_access"] },
        "role": { "type": "string", "enum": ["student", "organizer", "admin"] },
        "createdAt": { "type": "string" },
        "termsAcceptedAt": { "type": "string" },
        "termsVersion": { "type": "string" },
        "referralSource": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "testTrack": { "type": "string" },
        "targetUniversityId": { "type": "string" },
        "targetExamDate": { "type": "string" },
        "weakSubjects": { "type": "array" },
        "testsUsedToday": { "type": "number" },
        "boardyQuestionsUsedToday": { "type": "number" },
        "lastUsageDate": { "type": "string" }
      },
      "required": ["uid", "email", "name", "plan", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "Student review and rating with moderation status and verified badge.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "nameDisplayChoice": { "type": "string", "enum": ["first_initial", "first_only", "anonymous"] },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "exam": { "type": "string" },
        "city": { "type": "string" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "isVerifiedStudent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "moderatedBy": { "type": "string" }
      },
      "required": ["uid", "rating", "text", "status", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "System runtime configurations including reviews display toggles.",
      "type": "object",
      "properties": {
        "showPlaceholders": { "type": "boolean" },
        "placeholderTarget": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private student user profile documents."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Student reviews and ratings submitted for moderation."
    },
    "/config/{configDoc}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global application configuration documents."
    }
  }
}
