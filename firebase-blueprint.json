{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile, preferences, onboarding choices, role, and plan metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "premium", "starter", "steady_climb", "all_access"] },
        "role": { "type": "string", "enum": ["student", "organizer", "captain", "admin"] },
        "roles": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "termsAcceptedAt": { "type": "string" },
        "termsVersion": { "type": "string" },
        "referralSource": { "type": "string" },
        "referredBy": { "type": "string" },
        "onboardingCompleted": { "type": "boolean" },
        "testTrack": { "type": "string" },
        "targetUniversityId": { "type": "string" },
        "targetExamDate": { "type": "string" },
        "targetExamDaysLeft": { "type": "number" },
        "weakSubjects": { "type": "array" },
        "testsUsedToday": { "type": "number" },
        "boardyQuestionsUsedToday": { "type": "number" },
        "lastUsageDate": { "type": "string" },
        "streak": { "type": "number" },
        "streakDays": { "type": "number" },
        "testHistory": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "suspended", "disabled"] }
      },
      "required": ["uid", "email", "name", "plan", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "Student review and rating with moderation status and verified badge.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "nameDisplayChoice": { "type": "string", "enum": ["first_initial", "first_only", "anonymous"] },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "exam": { "type": "string" },
        "city": { "type": "string" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "isVerifiedStudent": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "rating", "text", "status", "createdAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Student plan upgrade request with manual payment slip proof.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "planId": { "type": "string", "enum": ["pro", "premium"] },
        "durationMonths": { "type": "number" },
        "amountPkr": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bank_transfer", "jazzcash", "easypaisa"] },
        "proofUrl": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["userId", "planId", "amountPkr", "paymentMethod", "status", "createdAt"]
    },
    "EventSession": {
      "title": "EventSession",
      "description": "Boardly Blitz, Boardly Arena, or Study Circle live competitive session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["blitz", "arena", "circle"] },
        "title": { "type": "string" },
        "organizerId": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "questionCount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "pending", "scheduled", "live", "ended", "cancelled"] },
        "capacity": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "type", "scheduledAt", "durationMinutes", "status"]
    },
    "OrganizerApplication": {
      "title": "OrganizerApplication",
      "description": "Application to become an approved Study Circles organizer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "institution": { "type": "string" },
        "role": { "type": "string" },
        "audienceSize": { "type": "string" },
        "reason": { "type": "string" },
        "contactLink": { "type": "string" },
        "rulesAccepted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "fullName", "city", "institution", "status", "createdAt"]
    },
    "CaptainApplication": {
      "title": "CaptainApplication",
      "description": "Application to become an official Campus Captain student ambassador.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "institution": { "type": "string" },
        "academicYear": { "type": "string" },
        "socialHandles": { "type": "string" },
        "reason": { "type": "string" },
        "rulesAccepted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "suspended"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "fullName", "city", "institution", "status", "createdAt"]
    },
    "CrewApplication": {
      "title": "CrewApplication",
      "description": "Application to become a Boardly Crew student ambassador representing Boardly and SHS Virtual Academy.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "institution": { "type": "string" },
        "promotionPlan": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["userId", "fullName", "email", "phone", "institution", "promotionPlan", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit log entry recording administrative mutations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["adminId", "action", "targetType", "targetId", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "System runtime configurations including reviews toggles and feature flags.",
      "type": "object",
      "properties": {
        "showPlaceholders": { "type": "boolean" },
        "placeholderTarget": { "type": "number" },
        "boardyEnabled": { "type": "boolean" },
        "eventsEnabled": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "admins": { "type": "array" }
      }
    },
    "SubjectPoolQuestion": {
      "title": "SubjectPoolQuestion",
      "description": "MCQ record in dedicated subject pool (e.g. questions_mathematics) with topic, stem, options, correct answer, explanation, and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "chapter": { "type": "string" },
        "text": { "type": "string" },
        "options": { "type": "array" },
        "correct": { "type": "number" },
        "explain": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "status": { "type": "string", "enum": ["draft", "reviewed", "published"] }
      },
      "required": ["id", "subject", "topic", "text", "options", "difficulty", "status"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Sanitized student profile visible on leaderboards, squads, and public surfaces. Contains NO email, phone, or payment fields.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarKey": { "type": "string" },
        "avatarVariant": { "type": "string" },
        "photoURL": { "type": "string" },
        "crewId": { "type": "string" },
        "crewName": { "type": "string" },
        "role": { "type": "string" },
        "shortId": { "type": "string" },
        "equipped": { "type": "object" },
        "publicStats": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Student Koban wallet with balance, owned cosmetics array, and currently equipped items.",
      "type": "object",
      "properties": {
        "balance": { "type": "number" },
        "owned": { "type": "array" },
        "equipped": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["balance", "owned", "equipped"]
    },
    "KobanRequest": {
      "title": "KobanRequest",
      "description": "Student request to purchase Kobans via JazzCash or EasyPaisa manual payment slip.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amountKobans": { "type": "number" },
        "amountPkr": { "type": "number" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["userId", "amountKobans", "amountPkr", "transactionId", "status"]
    }
  },
  "firestore": {
    "/questions_mathematics/{qId}": {
      "schema": { "$ref": "#/entities/SubjectPoolQuestion" },
      "description": "Dedicated subject question pool for Mathematics MCQs."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles, roles, plan metadata and daily allowances."
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Publicly readable sanitized user profiles for leaderboards and crew rosters."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Student Koban balance and owned cosmetics inventory."
    },
    "/kobanRequests/{requestId}": {
      "schema": { "$ref": "#/entities/KobanRequest" },
      "description": "Pending and reviewed Koban top-up purchase requests."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Student reviews and ratings submitted for moderation."
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Student plan upgrade requests with payment receipts."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/EventSession" },
      "description": "Live Blitz, Arena, and Circle competitive testing sessions."
    },
    "/organizerApplications/{appId}": {
      "schema": { "$ref": "#/entities/OrganizerApplication" },
      "description": "Study Circles organizer registration applications."
    },
    "/captainApplications/{appId}": {
      "schema": { "$ref": "#/entities/CaptainApplication" },
      "description": "Campus Captain ambassador registration applications."
    },
    "/crewApplications/{appId}": {
      "schema": { "$ref": "#/entities/CrewApplication" },
      "description": "Boardly Crew student ambassador registration applications."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit trail."
    },
    "/config/{configDoc}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global application configuration documents."
    }
  }
}
